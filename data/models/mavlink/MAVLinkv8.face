            <element
                xmi:id="EAID_E4A57064_F91E_4cea_8915_E2586756CC3E"
                name="RevolutionsPerMinute"
                description="Unit of measure for representing the frequency of rotation."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_9948928A_E5D5_4399_81B8_D1B7A8D0D017"
                name="WattsPerSteradian"
                description="Unit of measure for representing the radiant intensity of an object."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_EB709A75_CD50_4887_8E40_086CE821CBAA"
                name="AmpsPerMeter"
                description="Unit of measure for representing a magnetic field strength. Derived SI unit"
                xmi:type="logical:Unit"/>
            <element
                xmi:id="SDM_E66DB487_0820_419A_A64B_112EC00B15EE"
                name="DecibelMilliwatt"
                description="The decibel milliwatt or dBm is a unit for the measurement of the strength of a signal expressed in decibels relative to one milliwatt."
                xmi:type="logical:Unit"/>
          </ldm>
        </ldm>
        <ldm
            xmi:id="EAID_BC922F67_DA3D_4cf0_8EB2_27B5FCFE7E09"
            name="DryVolume"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_4E83620B_DF8D_4a73_BCD8_CFCE5F8CE838"
              name="DryBushelsUS"
              description="Unit of measure in the US Customary System for representing the volume of dry materials.  It is equal to 4 (dry, US) pecks or 32 (dry, US) quarts."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_3C7531E9_39D0_4c97_92DF_6EE768E48340"
              name="DryBarrelsUS"
              description="Unit of measure in the US Customary System for representing the volume for dry materials.  It is equal to 7,056 cubic inches or 115.6 liters."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_03EC1A39_CC6B_425c_A594_99607CEC301D"
              name="DryGallonsUS"
              description="Unit of measure in the US Customary System for representing the capacity of dry measures.  It is equal to 4 (dry, US) quarts or 268.8025 cubic inches."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_66072D3A_A38C_4f03_B011_ACBCB092388E"
              name="DryPecksUS"
              description="Unit of measure in the US Customary System for representing the capacity of dry measures.  It is equal to 8 (dry, US) quarts or 2 (dry, US) gallons."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_0B14534E_61DC_4b30_BA8A_1B4CAEE4707B"
              name="DryPintsUS"
              description="Unit of measure in the US Customary System for representing the capacity of dry goods, equal to 1/2 of a (dry, US) quart."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_3716B9AA_FCB9_48c8_B7C4_6A14551BE748"
              name="DryQuartsUS"
              description="Unit of measure in the US Customary System for representing the capacity of dry goods, equal to 1/4 of a (dry, US) gallon or 57.75 cubic inches."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_48235C2B_6A88_44d9_8D89_C6B2AB511F64"
            name="ElectricCharge"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_F0BEB8DA_1C6E_43a8_A030_C04F74B8E417"
              name="Coulombs"
              description="Unit of measure for representing the electric charge, equal to the quantity of electricity conveyed in one second by a current of one amp."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_611BFBF3_9651_4770_BEED_69B1E5BA509A"
              name="AmpHours"
              description="Unit of measure for representing the electric charge noting the amount of electricity transferred by a current of one amp in one hour."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_8837C190_8C86_48d4_88A1_AB1DA8E83D36"
              name="MilliampHours"
              description="Unit of measure for representing the electric charge which is one thousandth of an amp hour."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_17544AD5_99C8_431e_9230_A18EB54B2344"
            name="ElectricCurrent"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_1BC72413_1442_4d9a_BBC6_5D13EA4B334F"
              name="Amps"
              description="Unit of measure for representing the rate at which electric current flows."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_C5C03122_CF73_47ec_8478_2807E78D3CB0"
              name="Milliamps"
              description="Unit of measure for representing small electric currents, 1000th of an amp."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_DA5A7941_955C_4E69_8D37_B6CC5423D569"
              name="Microamps"
              description="Unit of measure for electrical current representing one millionth of an amp."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_B154CE3D_56FD_4CA4_8734_95A6C85C65AF"
              name="Nanoamps"
              description="Unit of measure for electrical current representing one billionth of an amp."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_A36EF35D_CBBB_4A06_A01A_6D40A591980A"
              name="Picoamps"
              description="Unit of measure for electrical current representing one trillionth of an amp."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_D765AAFC_D4C8_42a2_9ACB_45F8FDB3C6C9"
            name="ElectricFieldStrength"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_F891B933_289F_4ef0_9131_3FF6843D84F4"
              name="VoltsPerMeter"
              description="Unit of measure for representing electric field strength. An SI Unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_141C89BD_8FBF_4ba9_8C07_06EA541A4D65"
            name="AbsorbedDose"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_06F05060_CF06_4f65_A9AF_75CA9D6D4343"
              name="Grays"
              description="Unit of measure for the absorption of one joule of radiation energy by one kilogram or matter."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_A48F5144_B237_48e3_95DE_91E8428E64AC"
            name="AbsorbedDoseRate"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_F8CE6A2C_0E47_4f2f_88E0_5F255664DCDA"
              name="GraysPerSecond"
              description="Unit of measure for the rate of the absorption of one joule of radiation energy by one kilogram or matter over a one second of time."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_F0484DCD_1396_4317_A8A3_067DDB8A1CC3"
            name="Acceleration"
            xmi:type="datamodel:LogicalDataModel">
          <ldm
              xmi:id="EAID_06176F99_5497_4016_AB99_E148D5C196E8"
              name="AngularAcceleration"
              xmi:type="datamodel:LogicalDataModel">
            <element
                xmi:id="EAID_8864E77B_D4D8_4491_8145_285B1F8959A2"
                name="DegreesPerSecondPerSecond"
                description="Unit of measure for the rate of change of an angular speed in which the base angular measure unit is degrees."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_F2444AAF_68C5_4355_8AB0_5BFC0A73975F"
                name="RadiansPerSecondPerSecond"
                description="Unit of measure for the rate of change of an angular velocity in which the base angular measure unit is radian."
                xmi:type="logical:Unit"/>
          </ldm>
          <ldm
              xmi:id="EAID_341B2966_715A_4534_BA74_851528FAF3AE"
              name="LinearAcceleration"
              xmi:type="datamodel:LogicalDataModel">
            <element
                xmi:id="EAID_FE537E8B_388B_421c_8112_91CC5D87E3A1"
                name="g"
                description="The nominal gravitational acceleration of an object in a vacuum near the surface of the Earth. It is defined by standard as 9.80665 m/s^2, which is exactly 35.30394 km/(h·s) (about 32.174 ft/s^2, or 21.937 mph/s)."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_FCADE251_5B0A_4336_9E35_DE698096B06F"
                name="FeetPerSecondPerSecond"
                description="Unit of measure for the rate of change of velocity in which the base distance measure traveled is feet."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_9B5484D4_F922_407d_9E61_17E56532FDD8"
                name="KnotsPerSecond"
                description="Unit of measure for the rate of change of velocity in which the base velocity measure is knots."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_59A485AE_23F2_4b2d_87E7_18ECB59553EE"
                name="MetersPerSecondPerSecond"
                description="Unit of measure for the rate of change of velocity in which the base distance measure traveled is meters."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="SDM_CE7817D9_EFAC_4C24_8E10_A0CDABACE476"
                name="micro_g"
                description="The nominal gravitational acceleration of an object in a vacuum near the surface of the Earth, measured in millionths of a g."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="SDM_CC8A6543_AE1A_4F95_ADD3_6E4338ED9F40"
                name="InchesPerSecondPerSecond"
                description="Unit of measure for the rate of change of velocity in which the base distance measure traveled is inches."
                xmi:type="logical:Unit"/>
          </ldm>
        </ldm>
        <ldm
            xmi:id="EAID_07C807C7_A137_4da8_A9B6_E4317F682AC7"
            name="AmountOfConcentration"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_0B528C0C_B50B_4152_89FE_09BA977E13FE"
              name="MolesPerCubicMeter"
              description="Unit of measure for the number of atoms of a substance per unit volume."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_92823862_B9DB_4795_8B2E_8C0F397E54C3"
            name="AmountOfSubstance"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_81285D76_2D91_4edd_B41D_009A1301FB63"
              name="Moles"
              description="Unit of measure to express amounts of a chemical substance, defined as the amount of any substance that contains as many elementary entities as there are atoms in 12 grams of pure carbon-12."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_8E0AE736_DA76_4d8e_904C_1A89CB353790"
            name="Angle"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_6BE551B4_AC4C_467d_8264_95EB34EF81FE"
              name="DegreesOfArc"
              description="Unit of measure for a plane angle representing 1/360 of a full rotation. Not an SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_B852B3B4_206E_400b_B352_D86D2DC60748"
              name="Gradians"
              description="Unit of measure for a pane angle representing 1/400 of a full rotation. Not an SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_8BCEBA5A_6555_4984_B381_F8F96DA34437"
              name="MinutesOfArc"
              description="Unit of measure for angular measurement equal to 1/60 of one degree, because one degree is 1/360 of a circle, one minute of arc is 1/21,600 of a circle."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_DDC5A152_31FF_4e32_815A_3A1EE216C85A"
              name="Radians"
              description="Unit of measure for angular measurement equal to the length of a corresponding arc of a unit circle, one radian is just under 57.3 degrees. It is a SI derived unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_D4279E45_927A_442f_AC92_E62BA52F5D2C"
              name="SecondsOfArc"
              description="Unit of measure for angular measurement equal to 1/60 of one minute because one degree is 1/360 of a circle, one minute of arc is 1/21,600 of a circle and one second of arc is 1/1296000."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_7D11C92B_E44B_451f_BBE2_88A81B7C9D6F"
              name="Turns"
              description="Unit of measure for angular measurement equal to 360 degrees or 2 pi radians. 1 revolution."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_868CF58F_8777_4443_9E23_8D155F08799B"
            name="Area"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_579A46B3_B398_4030_9A44_1D66192DE8DE"
              name="Acres"
              description="Unit of measure for land area in US and Britain, defined as 1/640 of a square mile."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_5D6C29C2_C26C_4503_AE5B_AF304582BFAF"
              name="Barns"
              description="Unit of measure for area in nuclear physics expressing the cross sectional are of nuclei and nuclear reactions. Is approximately the cross sectional area of a uranium&apos;s nucleus."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_90E8AA70_4288_4042_B946_342AAE7B015D"
              name="Hectares"
              description="Unit of measure in the meter system for land area defined as 10,000 square meters."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_A4DFC00C_AF69_43aa_865D_A4574343F7A1"
              name="SquareFeet"
              description="Unit of measure for area equal to a square measuring one foot on each side, not an SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_85A3E015_825D_426b_A14C_6FE8FADD7F5B"
              name="SquareKilometers"
              description="Unit of measure is a decimal multiple of the surface area measure square meters, and is a derived SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_C4A8FCC1_585A_4d82_B7BF_606489503F25"
              name="SquareMeters"
              description="Unit of measure for surface area equal to a square measuring one meter on each side, and is a derived SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_8C7E4423_1F5E_47c9_A4FE_AC528FC574E8"
              name="SquareMiles"
              description="Unit of measure for area equal to the area of a square of one statute mile, not an SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_B42BEFE9_0456_4459_99FF_21D9648CB575"
              name="SquareCentimeters"
              description="Unit of measure is a decimal multiple of the surface area measure square centimeters, and is a derived SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_74A675FC_8627_4A57_962E_709CF47AF057"
              name="SquareInches"
              description="Unit of measure for area equal to a square measuring one inch on each side, not an SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_B0CBA8BA_32CE_4502_8F82_F23D07B10D1D"
              name="SquareMillimeters"
              description="Unit of measure is a decimal multiple of the surface area measure square millimeters, and is a derived SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_6E9EF6DB_3843_478F_8298_7B0340C10E2F"
              name="SquareNauticalMiles"
              description="Unit of measure for area equal to the area of a square of one nautical mile, not an SI unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_1D757B7B_AA6B_475c_BC94_5ED6388E1449"
            name="CatalyticActivity"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_67C6498E_77C1_46dd_8018_6577637A7D29"
              name="Katals"
              description="Unit of measure for quantifying the catalytic activity of enzymes and other catalysts, is SI unit of catalytic activity."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_4D16D625_6245_4ddc_A597_C7A4FE9AA71B"
            name="Force"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_F4C79394_2908_4acb_9317_6E30C94B489D"
              name="Dynes"
              description="Unit of measure for representing a unit of force specified in the Centimeter Gram Second system of units."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_3F9CBF28_F842_4896_ABEC_B4498760BD80"
              name="Newtons"
              description="Unit of measure for representing the force that would give a mass of one kilogram an acceleration of one meter per second per second and is equivalent to 100,000 dynes. An SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_E876EE63_4DAE_468A_84B2_5A4A8932D829"
              name="PoundsForce"
              description="Often represented as lbf, pounds-force is a unit of measure for representing force equal to 4.448222 Newtons."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_9AED26D4_74CC_4A39_B184_85F6F038BADC"
              name="FootPounds_Torque"
              description="Unit of torque equal to the force of one pound(force) acting perpendicularly to an axis of rotation at a distance of one foot."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_A521DBEC_C8C6_4ab0_A723_98FF5C6418B9"
            name="Frequency"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_161469CC_7BFE_4206_BF8E_17E105C1A679"
              name="Hertz"
              description="Unit of measure for representing frequency, equal to one cycle per second. An SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_F7DB7C83_5B79_4a4b_AEEE_FF7AAB4861E5"
              name="Gigahertz"
              description="Unit of measure for representing frequency used to measure the clock rate of modern digital logic, equal to one billion hertz."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_2DC04833_07D0_462c_B494_1AAF26BAC3F8"
              name="Kilohertz"
              description="Unit of measure for representing frequency equivalent to 1,000 cycles per second or 1,000 hertz."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_B757844F_7DD2_4be1_B0B0_9AAC190AA821"
              name="Megahertz"
              description="Unit of measure for representing one million hertz, as measure of frequency of radio transmissions or transmission speeds of electronic devices."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_2A5AEA56_CAFC_4AEF_9D43_5E653F395D7A"
              name="Terahertz"
              description="Unit of measure for representing one trillion hertz, as measure of frequency of advanced communication and infrared spectroscopy."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_6A88C4F4_1721_4f53_BB31_F3254300B00D"
            name="HeatCapacity"
            xmi:type="datamodel:LogicalDataModel"/>
        <ldm
            xmi:id="EAID_FBAA40BF_3DE0_4d3f_93DF_689E6D11CE27"
            name="Illuminance"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_65D4712B_C8F8_4e24_98E0_32A8040A0F94"
              name="Lux"
              description="Unit of measure for representing illumination equal to the direct illumination on a surface that is equal to one lumen per square meter. An SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_01CFBEEB_B898_4df8_995C_036BDB6C4188"
              name="Phot"
              description="Unit of measure for representing illuminance equal to one lumen per square centimeter in the Centimeter Gram Second system."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_A3FBB11C_EC48_4816_9676_9C1B6593411C"
            name="Inductance"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_56F719FC_B33B_44e1_9D77_5D3C3D692182"
              name="Henrys"
              description="Unit of measure for representing inductance equal to an electromotive force of one volt in a closed circuit with a uniform rate of change of current of one amp per second. An SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_37066CF1_9515_4b75_B009_12F418FEA4B0"
              name="Microhenrys"
              description="Unit of measure for representing inductance equal to 1 millionth of a henry."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_3B3AB347_3754_436c_9C41_A0E33CD813ED"
              name="Millihenrys"
              description="Unit of measure for representing inductance equal to 1 thousandth of a henry."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_64408E5C_0BF5_48cd_A9C8_196D035D628E"
            name="Length"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_A763DED3_CE36_462f_9C64_C385D35A8F03"
              name="Angstroms"
              description="Unit of measure for representing length equal to one hundred-millionth of a centimeter mainly to express wavelengths and interatomic distances."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_BB032E2F_0B77_4617_BEB8_CBF2872478B8"
              name="AstronomicalUnits"
              description="Unit of measure for representing the mean distance between the Earth and the Sun, equal to 149.6 million kilometers."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_55B68600_CD69_459e_825D_A0EF0067E79A"
              name="Cables"
              description="Unit of measure for representing length as a nautical unit of measure equal to one tenth of a nautical mile or 185.2 meters."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_F6A1CE92_DD0B_4f03_8AEC_CE88E62A1C0D"
              name="Centimeters"
              description="Unit of measure for representing length equal to one hundredth of a meter."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_19B91A7E_DD89_458f_BA4F_63B55DCDD16A"
              name="Chains"
              description="Unit of measure for representing a geodetic measure used for land survey, equal to 66 feet."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_90F83E4E_186E_43ce_9C8C_9E618E60F133"
              name="DataMiles"
              description="Unit of measure for representing radar related subjects equal to 6,000 feet."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_A41BDA35_F482_48e1_8588_B676BF4C8011"
              name="Fathoms"
              description="Unit of measure for representing depth of water equal to 6 feet."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_4B11E95B_FBAD_48c8_A03C_B7E641F18AFE"
              name="Feet"
              description="Unit of measure for representing length as multiple units of the international foot, equal to 12 inches."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_114E6AF4_7196_454e_AF95_281046536321"
              name="Inches"
              description="Unit of measure for representing length in the imperial and US customary systems of measurement."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_9782EE69_B788_462b_8852_563747B1F80F"
              name="Kilometers"
              description="Unit of measure for representing length equal to 1000 meters."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_0DA0C3BF_9EF2_44c7_99A8_F9D8677BA783"
              name="Links"
              description="Unit of measure for representing length equal to 7.92 survey inches formerly used in land surveying."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_0A9F29A7_3ABC_4790_9E6D_CEBD6C7DBE5E"
              name="Meters"
              description="Unit of measure for representing length equal to the distance traveled in a vacuum by light in 1/299, 782, 458 second or to about 39.37 inches. An SI Unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_3A901F73_BD0D_4479_AAF0_58AB0A05E545"
              name="MetricMiles"
              description="Unit of measure for representing length in international athletics of 1500 meters."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_380536E1_27EB_4939_AA22_68976D95172B"
              name="Millimeters"
              description="Unit of measure for representing length equal to one thousandth of a meter."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_705F2A05_3E50_4ecd_AC15_ED90D7540C76"
              name="NauticalMiles"
              description="Unit of measure for representing length at sea or air travel equal to 1.15 miles"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_27B71847_5DA3_49e8_9ECD_0965941CC914"
              name="ReciprocalMeters"
              description="Unit of measure for representing a measure of the shape of a curved surface equal to the reciprocal of the radius of curvature of a surface in meters."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_337EB82F_0B9D_44ec_963D_16B87BDBE65E"
              name="Rods"
              description="Unit of measure for representing length equal to 5 1/5 yards or 16 1/2 feet used in land surveying."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_721BF4F7_FF61_4e7e_93A4_4708E22C0C4F"
              name="StatuteMiles"
              description="Unit of measure for representing length on land in English speaking countries equal to 5,280 feet."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_25E89165_B7E4_4b86_A7F5_CB20E507EE6F"
              name="Yards"
              description="Unit of measure for representing length in the US Customary and British Imperial Systems equal to 3 feet."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_E4ACF54F_8633_465A_BDB1_56AA8FEA87B0"
              name="Nanometers"
              description="Unit of measure for representing length equal to one billionth of a meter."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_C13D2921_9AB4_407a_B3ED_BB3F5CB60DFA"
            name="Luminance"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_95E8CD97_D12C_43b4_AC04_AEFE6A88D852"
              name="CandelasPerSquareMeter"
              description="Unit of measure for representing light emitted per unit area, commonly used to specify the brightness of a display device. An SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_C1D5EE04_3949_4231_877F_74D1CE7E8C39"
              name="Stilbs"
              description="Unit of measure for representing luminance in the Centimeter Gram Seconds system for objects that are not self-luminous, equal to one candela per square centimeter."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_C4AE669F_20BA_483f_A73F_0C3FFDE10B93"
            name="LuminousFlux"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_4B042F46_5BE0_4555_BE22_C079264EEC1E"
              name="Lumens"
              description="Unit of measure for representing luminous flux, equal to the amount of light emitted per second in a unit solid angle of on steradian from a uniform source of one candela. An SI unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_2F1A2D15_E3D5_481a_B6B2_21EFA023BBB2"
            name="ElectricalCapacitance"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_2DEC664F_516A_499d_A29B_661CC1D8C7B2"
              name="Farads"
              description="Unit of measure for representing the capacitance of a capacitor across which one coulomb of charge causes a potential difference of one volt. An SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_98A7B19F_9EE9_4E06_BC75_204F8458D0DA"
              name="Microfarads"
              description="Unit of measure for capacitance representing one millionth of a Farad."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_795630C6_4B28_4F2F_97D7_07B8DA7B21D5"
              name="Nanofarads"
              description="Unit of measure for capacitance representing one billionth of a Farad."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_8938C37B_CD0E_4226_8B53_732A2EDEF96A"
              name="Picofarads"
              description="Unit of measure for capacitance representing one trillionth of a Farad."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_F21DDA2E_6B43_4465_AC12_4EE82DAD6D9F"
            name="ElectricalConductance"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_35FE1B11_2FBC_48c9_BC83_5FBACCC37648"
              name="Siemens"
              description="Unit of measure for representing electrical conductance equal to 1 reciprocal ohm. An SI unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_DD382BB0_A1C7_4ad2_B829_1460CDE07A8B"
            name="ElectricalResistance"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_86DA43C5_3454_4f35_9359_E73F1FA7A235"
              name="Ohms"
              description="Unit of measure for representing electrical resistance of a circuit in which an electromotive force of one volt maintains a current of one amp. An SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_5ED25A27_0996_4f32_92CE_6FCC0BAB86A9"
              name="Kiloohms"
              description="Unit of measure for representing electrical resistance equal to 1000 ohms."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_51EC828B_E415_4906_8F6E_022EEF6545A7"
              name="Megaohms"
              description="Unit of measure for representing electrical resistance equal to 1,000,000 ohms."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_6CDBE16D_652A_4e06_AB94_87B0AB825592"
            name="Energy"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_6BEAC65A_17AD_49d0_A7D3_0A49C14B7489"
              name="Joules"
              description="Unit of measure for representing the work done by a force of one newton when its point of application moved one meter in the direction of action of the force. An SI Unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_ABE41825_9C94_44f1_8193_DA019AF6540E"
              name="KilowattHours"
              description="Unit of measure for representing electrical energy equivalent to a power consumption of 1,000 watts for 1 hour."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_C4EEB582_915F_457c_90BA_1CDB5A7D47B6"
            name="Entropy"
            xmi:type="datamodel:LogicalDataModel"/>
        <ldm
            xmi:id="EAID_2D1B5992_D34F_475c_AC12_E41665A3D76D"
            name="EquivalentDose"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_FEF61F65_30EA_4429_BF95_EC1A4A8AC7E7"
              name="Sieverts"
              description="Unit of measure for representing dose equivalent, equal to an effective dose of a joule of energy per kilogram of recipient mass. An SI Unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_97441F90_FD0E_471e_A91C_E6A630DD00CA"
            name="Exposure"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_6440D768_FDAB_40bb_8BAC_9FA4C7C72394"
              name="CoulombsPerKilogram"
              description="Unit of measure for representing radiation exposure in which electrical charges (ion pairs) in a kilogram of air.  A derived SI unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_EADEC90A_9D10_4328_9A03_84D925C7EDE4"
            name="FluidVolume"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_4DD8AE21_0EB0_492f_8BBF_048D399C924F"
              name="FluidCupsUS"
              description="Unit of measure in the US Customary System for representing the liquid volume for cooking ingredients and is defined as 1/2 of a (fluid, US) pint."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_F1B57A45_867B_4808_936F_6C4F1F50EF10"
              name="FluidDramsUS"
              description="Unit of measure for representing the volume or capacity in the apothecary system, equal to 1/8 of a (fluid, US) ounce."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_0976132A_E70B_4d8f_B219_B8E01258897D"
              name="FluidOuncesUS"
              description="Unit of measure in the US Customary System for representing liquid volume or capacity equal to 1.8046875 cubic inches or 29.5735295625 milliliters."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_13E19836_0B3F_4546_8FB5_5C2F7170F7F6"
              name="FluidGallonsUS"
              description="Unit of measure in the US Customary System for representing the liquid volume or capacity equal to 4 quarts (fluid, US) or 231 cubic inches."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_E48F9A6C_D5FF_4ee5_AD73_429FF52D50D7"
              name="FluidGillsUS"
              description="Unit of measure in the US Customary System for representing liquid volume, defined as 1/2 of a (fluid, US) cup."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_A5C59AE1_1DF6_4cf7_8D52_99A1D52461BA"
              name="FluidBarrelsUS"
              description="Unit of liquid measure in the US Customary System for representing 31.5 (fluid, US) gallons."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_DA6FF1E2_BE3B_4d32_B429_82D068FE4855"
              name="FluidMinimsUS"
              description="Unit of measure in the US Customary System for representing the smallest unit of liquid measure 1/60 of a (fluid, US) dram, or roughly equivalent to one drop."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_11AAA861_4C74_4f26_BA69_9D7BA3EAC5FD"
              name="OilBarrelsUS"
              description="Unit of measure for representing an oil barrel holding 42 (fluid, US) gallons."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_896D563A_1CED_48f3_AD92_234DF3ADEE9F"
              name="FluidPintsUS"
              description="Unit of measure in the US Customary System for representing liquid volume or capacity equal to 1/8 of a (fluid, US) gallon."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_9448BB79_C145_432f_90B7_2535DAB51CED"
              name="FluidQuartsUS"
              description="Unit of measure in the US Customary System for representing liquid volume or capacity equal to 1/4 of a (fluid, US) gallon."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_0BC25F42_D33B_4780_82D8_7508088534AE"
              name="TablespoonsUS"
              description="Unit of measure in the US Customary System for representing liquid volume or capacity equal to 1/2 of a (fluid, US) ounce or 3 teaspoons.  Typically used as a measure for cooking."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_B5226835_2703_4f5b_9837_13DE5347B9C6"
              name="TeaspoonsUS"
              description="Unit of measure in the US Customary System for representing liquid volume or capacity equal to 1/6 of a (fluid, US) ounce or 3 teaspoons.  Typically used as a measure for cooking."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_3749926F_19E5_47BB_9051_CF01610B4663"
              name="FluidAdelaidePints"
              description="Unit of measure for fluid volume representing 15 fluid ounces or 425 milliliters.  This is one ounce less than a standard US pint."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_C00995EC_762D_4025_97A8_93F26514E05A"
            name="MomentOfForce"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_C0B1C69D_4742_4acf_82CD_DB92D5878FAA"
              name="NewtonMeters"
              description="Unit of measure for representing torque resulting from a force of one newton applied perpendicularly to a moment arm which is one meter long. An SI unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_B5F13586_8376_4642_8FF5_D7F05C886A5B"
            name="Power"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_ACAA2155_27C3_4a8d_9F84_17451EC9DE42"
              name="Watts"
              description="Unit of measure for representing the power in an electric circuit in which the potential difference is one volt and the current one amp., equal to one joule per second and is an SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_259AD740_FA8C_420a_AD46_6F4FFF25F502"
              name="MetricHorsePower"
              description="One metric horsepower as the power to raise a mass of 75 kilograms against the Earth&apos;s gravitational force over a distance of one meter in one second: 75 kg · 9.80665 m/s^2 · 1 m / 1 s = 75 kgf·m/s = 1 PS. This is equivalent to 735.49875 W."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_EAABF1A2_EAED_43F3_9FE7_DA55937277AE"
              name="Milliwatts"
              description="Unit of measure for representing a small amount of electrical power, 1000th of a watt."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_CFAE4DA1_FA57_4367_B31E_B21331DDAA5B"
              name="Gigawatts"
              description="Unit of measure for power representing one billion watts."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_700A024E_BD32_4A94_B586_D6FD28026375"
              name="Kilowatts"
              description="Unit of measure for power representing one thousand watts."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_A3178A9A_E835_4FE6_8287_B66532358563"
              name="Microwatts"
              description="Unit of measure for power representing a one millionth of a watt."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_DD2F750E_6527_41BB_9E36_C3D6A1B21768"
              name="Nanowatts"
              description="Unit of measure for power representing a one trillionth of a watt."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_20724726_250C_4ff4_B6D2_8A7FA5801793"
            name="Permeability"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_88F0F618_A2DD_4536_921F_6D2E6CA1CD0D"
              name="HenrysPerMeter"
              description="Unit of measure for representing the permeability of a material surrounded by a single turn of a flat sheet conductor including an area of one square meter and length one meter which gives an inductance of one henry. A Derived SI Unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_53C9FC83_79BD_4e7e_A5D0_420F11424DC8"
            name="Permittivity"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_7A1862E4_E85E_46d5_8A59_F50EFBBE9131"
              name="FaradsPerMeter"
              description="Unit of measure for representing the resistance encountered when forming an electric field in a medium. An SI derived unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_4B7EA033_0489_40cf_B20F_DBA28D250A53"
            name="Pressure"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_C28AD0FA_5435_4be9_BC05_F718E801C001"
              name="Bars"
              description="Unit of measure for representing pressure equal to a million dynes per square centimeter used in meteorology to report atmospheric pressure."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_B12A36E4_D202_4eca_913A_41313B5C69F0"
              name="FlightLevel"
              description="Unit of measure for representing a surface of constant atmosphere pressure which is related to a specific pressure datum, 1013.2hPa, and is separated from other such surfaces by specific pressure intervals."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_0A0C5318_D176_4967_8B4E_E436A3715FF3"
              name="InchesOfMercury"
              description="Unit of measure for representing the pressure exerted by a column of mercury one inch high under standard conditions of temperature and gravity."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_C437C35F_4DFB_4200_8133_5DA158EB6085"
              name="MillimetersOfMercury"
              description="Unit of measure for representing the pressure exerted by a column of mercury one millimeter high under standard conditions of temperature and gravity."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_9CDA2125_1689_411c_AC85_04287E8FC3CE"
              name="Pascals"
              description="Unit of measure for representing pressure of one newton per square meter. An SI Unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_E55C3C11_FA94_4421_9280_F20C673B8919"
              name="Torr"
              description="Unit of measure for representing pressure with the ratio of 760 to 1 standard atmosphere, roughly equal to the fluid pressure exerted by a millimeter of mercury used in high-vacuum physics and engineering. A non-SI Unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_411C9D3A_3AC2_4123_BDAE_7F5C771611E6"
              name="PoundsPerSquareInch"
              description="Unit of measure for representing pressure based on the avoirdupois units resulting from a force of one pound-force applied to an area of one square inch. A non-SI Unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_5F438683_B8A8_4F86_9908_87F646114DB8"
              name="Hectopascals"
              description="Unit of measure for representing pressure of one hundred pascals."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_CE418444_A67F_4099_B63D_53960A3542FC"
              name="Kilopascals"
              description="Unit of measure for representing pressure of one thousand Pascals."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_56DA1A14_96A0_4F8C_BA95_1FDF85205C07"
              name="Millibars"
              description="Unit of measure for pressure representing one thousandth of a bar."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_FFD60F94_26E4_4BB2_A05B_C76AD722FD61"
              name="InchesOfWater"
              description="Unit of measure for representing the pressure exerted by a column of water one inch high under standard conditions of temperature and gravity."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_99CD3AB8_443B_403a_B846_2D5EB490CD77"
            name="Radiance"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_449612D3_50F4_4eb2_8187_91A1482ACE83"
              name="WattsPerSquareMeterSteradian"
              description="Unit of measure for representing radiance and is defined as the power per unit solid angle. An SI unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_C2C0FF0B_B5C6_4057_B8C1_61992C1C5CA0"
            name="RadiantIntensity"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_3A685039_DB3F_4044_AAEC_945F46598CC5"
              name="WattPerSteradian"
              description="Unit of measure for representing radiant intensity characterized as the emission of radiation by an antenna. An SI Unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_57EC71DE_6A7E_4cab_A347_3077716EF57E"
            name="Radioactivity"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_CAF4F95D_F642_423c_83A6_6219ED07002D"
              name="Becquerels"
              description="Unit of measure for representing radioactivity, defined as the activity of a quantity of radioactive material in which one nucleus decays per second. An SI derived unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_C8A344B6_9D5F_4024_9583_19169181C457"
            name="LuminousIntensity"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_846F619C_9BC7_40b2_AAA5_3CD2222F84CF"
              name="Candelas"
              description="Unit of measure for representing luminous intensity emitted by a light source in a particular direction, weighted by the luminosity function. An SI Unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_A91A24BA_052C_4046_B78B_73C36C479497"
            name="MagneticField"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_4D37723D_ACC0_44e7_B1C7_6EB897E4F748"
              name="Oersteds"
              description="Unit of measure for representing magnetic field strength in the Centimeter Gram Second system."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_B6DFB41D_2B7F_44a2_AA9A_EF10F98EC4DA"
            name="MagneticFlux"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_1D856CCC_D134_490e_A26B_A55DE73BD59C"
              name="Maxwells"
              description="Unit of measure for representing magnetic flux equal to the flux through one square centimeter normal to a field of one gauss, in the Centimeter Gram Second system."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_FC322DA3_AB79_4c7d_8736_EC76A47812A8"
              name="Webers"
              description="Unit of measure for representing magnetic flux equal to the flux that produces in a circuit of one turn an electromotive force of one volt, when the flux is uniformly reduced to zero within one second. An SI unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_162DEF21_C862_442e_B0C3_3A2149F72396"
            name="MagneticFluxDensity"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_7F0BDC60_82FF_4291_993B_0247FE33C000"
              name="Gauss"
              description="Unit of measure for representing magnetic flux density equal one Maxwell per square centimeter, in the Centimeter Gram Second system."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_4733852F_C574_42b8_B6CD_6A665A869BCF"
              name="Teslas"
              description="Unit of measure for representing magnetic flux density equal to a flux of one weber in an area of one square meter. An SI unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_8145F73A_1151_4a74_A2CB_F0A732321088"
            name="Mass"
            xmi:type="datamodel:LogicalDataModel">
          <ldm
              xmi:id="EAID_AF92DCDD_8F89_4f00_9B77_3E15B22C9A2C"
              name="Avoirdupois"
              xmi:type="datamodel:LogicalDataModel">
            <element
                xmi:id="EAID_E2830A10_28D1_42e5_869C_C877BA89B178"
                name="Drams"
                description="Unit of measure for representing a unit of mass of 1/256 of a pound or 1/16 of an ounce."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_EBE1D89F_3A41_4039_965B_9C14FD995D1D"
                name="Hundredweights"
                description="Unit of measure for representing a unit of mass equal to 100 pounds defined and used in the US Customary System."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_05A0CF20_2537_4082_9DA0_CEC3B171F99D"
                name="LongHundredweights"
                description="Unit of measure for representing a unit of mass equal to 112 pounds defined and used in the Imperial System."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_6313EB2C_C1DF_4bb8_909E_706066DAC8C7"
                name="AvoirdupoisGrains"
                description="Unit of measure for representing a unit of mass of 1/7000 of a pound from the avoirdupois system based on the 16 ounce pound or 7,000 grains."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_40CDD4FC_7078_48ee_B9D8_D6DD15EB6D57"
                name="LongTons"
                description="Unit of measure for representing a unit of mass equal to 2240 pounds used in the Imperial System."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_E0C37101_E706_4367_B997_F415C16EBB5A"
                name="Ounces"
                description="Unit of measure for representing an avoirdupois unit of mass equal to 1/16 of an avoirdupois pound or 437.5 grains."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_2B44DABD_6782_433a_8B99_8AB710AFAC31"
                name="Pounds"
                description="Unit of measure for representing an avoirdupois unit of mass equal to 7000 grains."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_A6E38DAD_887B_4b79_8292_CD090E037FB9"
                name="Tons"
                description="Unit of measure for representing a unit of mass equal to 2000 pounds used in the US Customary System."
                xmi:type="logical:Unit"/>
          </ldm>
          <ldm
              xmi:id="EAID_E452AD3E_E6EF_48a3_9000_A486BFD74208"
              name="Troy"
              xmi:type="datamodel:LogicalDataModel">
            <element
                xmi:id="EAID_DCB6C9FA_27ED_4dc0_99C3_5BBAF1C6C58B"
                name="TroyOunces"
                description="Unit of measure for representing a unit of mass used for precious metals and gemstones equal to 480 grains."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_74D51E3B_0B05_4b5b_B9E4_0F2848DD100C"
                name="TroyPounds"
                description="Unit of measure for representing a unit of mass used for precious metals and gemstones equal to 5,760 grains."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_29152C26_65FA_4226_93D5_214F28E63E10"
                name="TroyGrains"
                description="Unit of measure for representing a unit of mass used for precious metals and gemstones equal to 1/60 dram or equal to the avoirdupois grain."
                xmi:type="logical:Unit"/>
          </ldm>
          <element
              xmi:id="EAID_353F519A_9F65_47ce_A46C_FFA8E2555DEA"
              name="Dalton_UnifiedAtomicMassUnits"
              description="Unit of measure for representing mass on an atomic or molecular scale defined as one twelfth of the rest mass of an unbound atom of carbon-12 in its nuclear and electronic ground state."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_D7D0A1EB_DF28_4ed9_B090_C877DCDEEDF0"
              name="ElectronMass"
              description="Unit of measure for representing electron rest mass is an atomic fundamental physical constant is defined as the mass of a stationary electron."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_E389C2FD_BCCD_4263_AF43_474D39577BFE"
              name="Grams"
              description="Unit of measure for representing a metric unit of mass equal to one thousandth of a kilogram."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_5B6C4513_5B50_45de_904F_CC6838B799B7"
              name="Milligrams"
              description="Unit of measure for representing a metric unit of mass equal to one thousandth of a gram."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_2B22C06E_920A_4f7d_A448_80257FE3E92C"
              name="Tonnes"
              description="Unit of measure for representing a metric unit of mass equal to 1,000 kilograms or 2, 240 pounds. A non-SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_A21827D1_48AF_4e25_A534_D2CDAE199D76"
              name="Kilograms"
              description="Unit of measure for representing the mass equal to the International Prototype of the Kilogram."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_3304E3B1_0D42_401C_9E60_2EDC3640ABBA"
              name="Slugs"
              description="Unit of measure for representing a mass that is accelerated by one foot per second squared when a net force of one pound is applied to it.  A slug is mass equal to 14.59390 kilograms."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_50215984_A859_4EC0_A1C1_499175FF4F05"
              name="Micrograms"
              description="Unit of measure for representing a metric unit of mass equal to one millionth of a gram."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_0FF1E286_BA63_4DB8_B514_17E46798BF0B"
              name="Nanograms"
              description="Unit of measure for representing a metric unit of mass equal to one billionth of a gram."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_546A6D41_44BA_4385_A7C3_2F0D7F0C2D66"
              name="Picograms"
              description="Unit of measure for representing a metric unit of mass equal to one trillionth of a gram."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_523ABAE7_04E0_4de7_B3FA_D0A3D1468D89"
            name="MassConcentration"
            xmi:type="datamodel:LogicalDataModel"/>
        <ldm
            xmi:id="EAID_A52F3819_F68E_49a2_AE92_3000B8873476"
            name="MolarEnergy"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_5E1C4348_C669_4229_A707_90C0BE07D7B1"
              name="JoulesPerMole"
              description="Unit of measure for representing the measure of the energy per amount of material. An SI derived unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_AF1BEB28_2C68_4f7a_A654_1A436CFDE512"
            name="MolarEntropy"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_F578A32F_EBCB_4a34_A6DB_0BFD0E4EEDCE"
              name="JoulesPerMoleKelvin"
              description="Unit of measure for representing molar heat capacity defining the amount of heat needed to increase the temperature of one mole of a substance by one degree."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_1A440A82_31D5_4a0d_B09E_D7771FF6A41C"
            name="Work"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_C1B2CBC7_C0DB_4a69_80B2_087D899DC14A"
              name="Ergs"
              description="Unit of measure representing work or energy equal to the work done by a force of one dyne when its point of application moves through a distance of one centimeter in the direction of the force, used in the Centimeter Gram Seconds system."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_C35A0ADB_25D4_4C44_ABC4_649F6D01953F"
              name="FootPounds_Work"
              description="Unit of measure representing the work done by a force of one pound(force) acting through a distance of one foot."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_43329893_F8AF_41cd_8872_35C8FFBFEFCA"
            name="UnitlessDimensionless"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_DA342318_2A86_40ad_9B8F_93BD6F02D542"
              name="Ratio"
              description="A unit used to specify the ratio of one value to another having the same units"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_0C482F2C_A548_4cf1_B9AD_5086FD62C41B"
              name="Unitless"
              description="A &quot;placeholder&quot; to specify for values that have no engineering units or where units are not meaningful, but a Unit specification is required"
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_BE375988_26A7_4ac0_98F8_C8F0339DF492"
            name="SolidAngle"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_02B1EB9C_7717_42b5_A24B_5BB6C5E413B4"
              name="SquareDegrees"
              description="Unit of measure for representing the measure of a solid angle used to measure parts of a sphere. A non-SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_51821B33_5943_4d6c_9667_151F4D916559"
              name="Steradians"
              description="Unit of measure for representing squared radian is the measure of a solid angle used to measure parts of a sphere. An SI unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_56EEC7F8_8058_43af_83D2_11480E771BBE"
            name="Speed"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_7D8284DB_98CF_48c0_B99D_81FB7F9FDE83"
              name="FeetPerMinute"
              description="Speed unit of feet per minute."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_005D48C3_E6E2_4f9f_9041_1E13D27392F4"
              name="FeetPerSecond"
              description="Speed unit of feet per second."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_D0BB71A9_1DA4_4b42_B20F_1DA918A74312"
              name="DegreesPerSecond"
              description="Unit of measure for representing rotational speed, defined by the change in orientation of an object, in degrees every second. An SI Unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_E3D2CD7F_05FE_4878_ACD3_C4E23734ED1F"
              name="KilometersPerHour"
              description="Unit of measure for representing a measure of speed expressed as the number of kilometers travelled in one hour."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_C791EA45_64E6_469f_A762_B7E86B5359A0"
              name="Knots"
              description="Unit of measure for representing a measure of speed equal to one nautical mile per hour."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_D656A860_B181_4712_B6C0_3CC4761A682D"
              name="MetersPerSecond"
              description="Unit of measure for representing speed and velocity. An SI derived unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_774E705B_1B1D_406a_8403_42360910A569"
              name="MilesPerHour"
              description="Unit of measure for representing speed expressing the number of statute miles covered in one hour used in the Imperial and US Customary systems."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_C21F5F62_131A_4807_894F_A58BF924B164"
              name="RadiansPerSecond"
              description="Unit of measure for representing rotational speed, defined by the change in orientation of an object, in radians every second. An SI Unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_5C4E1875_B52B_4a98_8F0E_A235796974BB"
              name="SpeedOfLight"
              description="Unit of measure for representing the speed of light in a vacuum, is a universal physical constant whose value is 299,792,458 meters per second."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_F0BA2B63_62FD_42c1_8A47_9706562E9E84"
              name="Mach"
              description="Unit of measure for representing the speed of sound, the distance travelled per unit of time by a sound wave propagating through an elastic medium."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_13B0C39A_148E_45EF_A7C7_F162A7306DDC"
              name="InchesPerSecond"
              description="Speed unit of inches per second."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_84B65442_5510_48d5_9976_18707D937C5A"
            name="Temperature"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_723C724A_263B_48fe_B9EA_6D471D78BECA"
              name="DegreesCelsius"
              description="Unit of measure for representing temperature where water freezes at 0 degrees and boils at 100 degrees."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_A1A79A69_F65A_4734_8957_894EFEDA1F5A"
              name="DegreesFarenheit"
              description="Unit of measure for representing temperature where water freezes at 32 degrees and boils at 212 degrees (at standard atmospheric pressure)."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_C06308E5_8978_48e2_963B_596CFB8C04A4"
              name="DegreesKelvin"
              description="Unit of measure for representing temperature at which all thermal motion ceases in the classical description of thermodynamics. An SI unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_93A2E7E2_61C3_48d8_98E7_CE20EF168722"
            name="ThermalConductivity"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_DE210BBE_A970_49f8_888D_776EC8E42FB3"
              name="WattsPerMeterKelvin"
              description="Unit of measure for representing thermal conductance where a material of one joule of energy per one second moves through the distance of one meter due to a temperature difference of one kelvin. An SI derived unit."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_2342696B_A50C_4a50_93E9_0C18B97AC18A"
            name="Time"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_55641AED_3F8A_497b_BF82_630E05CFCEE4"
              name="Days"
              description="Unit of time duration equal to 24 hours; approximately one rotation of the Earth"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_ACBBECC7_C23C_48d8_8355_ED0A3A3A3324"
              name="Hours"
              description="Unit of time duration equal to 60 minutes"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_DD9D1386_CC2E_4f76_BD72_A2E1BAF61CAC"
              name="Microseconds"
              description="Unit of time duration equal to one millionth of a second"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_CDB24D2F_2CBF_4617_BD58_7A64770B4AF7"
              name="Milliseconds"
              description="Unit of time duration equal to one thousandth of a second"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_D16C8EB8_AEA3_4dc4_B32D_2EA864931180"
              name="Minutes"
              description="Unit of time duration equal to 60 seconds"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_8E83CE63_89C9_4911_98A0_F7D3A60EF0EB"
              name="Nanoseconds"
              description="Unit of time duration equal to one billionth of a second"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_17A1BB83_047A_4b42_A183_1237BC07B435"
              name="Seconds"
              description="SI base unit of time. One second is defined to be the duration of 9192631770 periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the cesium 133 atom"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_85A59335_1C8F_47C0_8BEA_5FE1B34F6FAB"
              name="Years"
              description="Unit of time duration approximately equal to 365 days; approximately one orbit of the Earth around the Sun."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_7E4540FB_D607_4E34_8610_3397A8A19D1E"
              name="Months"
              description="Unit of time duration approximately equal to 30 days."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_A3D49224_E4EC_498F_8C79_0907AFC3F1C8"
              name="Weeks"
              description="Unit of time duration equal to 7 days."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_CB41E9DC_8FDC_405E_8D57_46803FEDE899"
              name="Picoseconds"
              description="Unit of measure for representing time equal to one trillionth of a second."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_6F074163_30AA_4B80_8CA3_99B88DF219D2"
              name="Femtoseconds"
              description="Unit of time duration equal to one quadrillionth of a second"
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_A65AABFB_BDEB_49f4_938A_0C6D0A2FAB3C"
            name="Viscosity"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_80D9C661_993E_4fd3_833C_855ABF3F1359"
              name="Centipoise"
              description="Units for dynamic (shear) viscosity, equivalent to milliPascal-seconds"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_F25C01B7_B6ED_481e_B13B_5EFA4E8A0315"
              name="Centistokes"
              description="Units for kinematic viscosity,1 centistokes (cSt) = 0.01 St= 0.000001 m^2/sec"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_1C753236_2F55_4424_9CA3_47AD45CC4934"
              name="PascalSeconds"
              description="SI units for dynamic (shear) viscosity"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_E1018FCF_16B7_4a50_8D59_EA9270C4288C"
              name="Poise"
              description="Units for dynamic (shear) viscosity. 1 Poise = 100 cP = 0.1 Pascal-seconds"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_610F07F0_80C3_4243_81DD_70AD7BF78660"
              name="SayboltUniversalSeconds"
              description="Obsolete units for kinematic viscosity. Conversion to the preferred units of centistokes (cSt) is defined in ASTM D 2161"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_9B5D0AEF_2419_442d_B413_AD98445E7BC7"
              name="SquareMetersPerSecond"
              description="SI units for kinematic viscosity"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_B146CC58_0C97_4511_A034_B1E3D4414251"
              name="Stokes"
              description=" Units for kinematic viscosity, 1 stokes (St) = 0.0001 m^2/sec"
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_9BAF9C2C_5BB2_4e98_994F_5BB8307528B8"
            name="Voltage"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_D1F6B8CB_00D0_447a_B871_02D5EA97DFED"
              name="ElectronVolts"
              description="Unit of measure representing the amount of kinetic energy gained by a single unbound electron when it accelerates through an electric potential difference of one volt. A non-SI unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_7DAFAFA2_9CA0_4db4_ADB9_A483D5B16E8D"
              name="Volts"
              description="Unit of measure representing the difference in electric potential between two points of a conducting wire when an electric current of one amp dissipates one watt of power between those points. An SI derived unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_5EB6B6BD_1749_4167_82F8_49A599D5BABA"
              name="Millivolts"
              description="Unit of measure representing the difference in electric potential between two points of a conducting wire, measured in thousandths of a volt."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_1F76BF9B_159D_4E39_B762_7570AE58A69C"
              name="Kilovolts"
              description="Unit of measure for voltage representing one thousand volts."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_97A1A2E3_E173_4B8E_8BD2_C94FF0460CE8"
              name="Megavolts"
              description="Unit of measure for voltage representing one million volts."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_B13CC278_3F9F_4ECF_9FAD_0C62D7981605"
              name="Microvolts"
              description="Unit of measure for voltage representing one millionth of a volt."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_F4FE45A0_0E6E_41d9_B525_A30FB6A008BC"
            name="Volume"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_253BAAF2_22DF_4e68_B114_3947BF549D8C"
              name="Liters"
              description="Unit of measure for representing 1,000 cubic centimeters.  0.946352946 liters is exacty equal to 1 (fluid, US) quarts."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_E959EB0F_095E_4e90_88F4_32E5490BB442"
              name="CubicFeet"
              description="Unit of measure representing volume of a cube measuring the same multiple of a foot unit in length on all sides."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_8EED50A7_7179_44ab_B373_930D69E2476B"
              name="CubicInches"
              description="Unit of measure representing volume of a cube measuring 1 in x 1 in x 1 in."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_B6983E55_B326_4925_B8B0_0EF9E75250DD"
              name="CubicMeters"
              description="Unit of measure representing volume of a cube measuring 1 m x 1 m x 1 m. A SI derived unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_8BA0E5B0_CB13_490a_9363_6A3C2C2B16B8"
              name="CubicMillimeters"
              description="Unit of measure representing volume of a cube measuring 1 mm x 1 mm x 1 mm. A SI derived unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_3DF7E5B0_A605_4e2b_BB15_B8EC36059B8B"
              name="CubicYards"
              description="Unit of measure representing volume of a cube measuring 1 yds x 1 yds x 1 yds."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_6C2D0767_7566_4967_B174_C1F38C5F3DC5"
              name="CubicCentimeters"
              description="Unit of measure representing volume of a cube measuring 1 cm x 1 cm x 1 cm. This is equivalent to one milliliter.  An SI derived unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_099CBE3A_8A07_48AB_BD16_53A518BD4EEB"
              name="Microliters"
              description="Unit of measure for volume representing one millionth of a liter."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_4C984D3B_12B8_41E6_A97D_086FF2A5A677"
              name="Milliliters"
              description="Unit of measure for volume representing one thousandth of a liter.  This is equivalent to one cubic centimeter."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_E119CB56_8C90_4344_9234_48BC281646E1"
            name="ElectricChargeDensity"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_DED3DC3D_2228_4180_9A4F_CF994B64B6CF"
              name="CoulombsPerMeter"
              description="Coulombs per meter"
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_8E188C8D_CA5B_49d9_B4B7_1E01E451F88D"
              name="CoulombsPerMeterPerMeterPerMeter"
              description="Unit of measure for representing one coulomb of electric charge per one cubic meter of volume."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_E991E9BF_F0B8_4b0f_80B6_9BCA1639DC0C"
              name="CoulombsPerMeterPerMeter"
              description="Unit of measure for representing one coulomb of electric charge per one square meter of surface."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_51FEBFF3_2234_4D6E_B64A_EE2EB5B6C1A0"
            name="Jerk"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_750A38C0_90B5_455B_BA1B_CAC2BCD32515"
              name="RevolutionsPerDayPerDayPerDay"
              description="Unit of measure for the rate of change of an acceleration in which the base angular measure unit is revolutions and the timeframe is days."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_57E28FB8_78E2_44DC_AD20_D1752A809FAD"
              name="MetersPerSecondPerSecondPerSecond"
              description="Unit of measure for the rate of change of acceleration in which the base distance measure traveled is meters."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="SDM_C4E7BEE5_53FE_48B6_AC07_8456042CE513"
            name="DistanceDerived"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="SDM_63EA6970_2C9C_4D4B_96FB_1F05F999D1C5"
              name="MetersPerSecondPerMeter"
              description="Unit of measure for representing the the change of speed per meter."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_E981B7A0_01B0_4879_B189_93FF58DE1021"
              name="KilogramsPerMeter"
              description="Unit of measure for representing the the change of mass per meter."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="SDM_83B576FD_ACDB_420F_AD83_6BE077EB9738"
            name="MassDerived"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="SDM_AC882252_91F5_439E_86B3_BBDFE2397841"
              name="NauticalMilesPerPound"
              description="Unit of measure for the distance traveled (in nautical miles) per pound."
              xmi:type="logical:Unit"/>
        </ldm>
        <element
            xmi:id="EAID_AFB0E821_EDA0_43fa_9BFE_6989D7A150D2"
            name="CountsPerSecond"
            description="Number of events that occur per second"
            xmi:type="logical:Unit"/>
        <element
            xmi:id="SDM_56BFF0BA_0CF4_4C0B_A403_946C1CF4125C"
            name="CountsPerMinute"
            description="Number of events that occur per minute."
