      <cdm
          xmi:id="SML_7097CBD3_2047_AA20_ADDB_77F18688F464"
          name="Apertures"
          description="This package models apertures which are areas designed to capture electromagnetic energy including antennas (both individual antennas and arrays), their properties, and their relationships to electromagnetic waves, sensors, and platforms."
          xmi:type="datamodel:ConceptualDataModel">
        <cdm
