            <element
                xmi:id="EAID_0C0725EB_2FB1_46d2_A11A_716E6D6299E3"
                name="Extent"
                description="Dimensions of the bounding region encompassing the item."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_1D725B44_BAC9_4733_8D4B_4F072340BC6F"
              name="LuminousIntensity"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_8B463517_0982_4cd0_884D_DD91D17AC345"
                name="LuminousIntensity"
                description="Wavelength weighted power emitted by a light source in a particular direction per unit solid angle."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_6133412F_3EAA_4a9b_8B54_C2A30F2E4A0C"
              name="Mass"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_5D0D98B4_F3C5_4131_ACA9_A6CBCDEE8F6B"
                name="Mass"
                description="Amount of matter in a physical body (solid, liquid, gas) which determines the body&apos;s resistance to being accelerated by a force and the strength of its mutual gravitational attraction with other bodies."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_259A9F0C_5DB1_4fb3_B9E2_C0EBB9654C1B"
              name="Orientation"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_AB3FAE18_6F92_4a74_812F_77AF2DCD6F6F"
                name="Orientation"
                description="Angular position of an object relative to a fixed reference frame that describes how the object is placed."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_87B06E46_6F77_4b0f_B10F_811F93CF30BF"
              name="Position"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_7CA3D9F9_0614_4f82_A971_D2367427403F"
                name="Position"
                description="Location of an item relative to a fixed reference frame."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_60F805D3_2250_4e40_81E6_5C474709C019"
              name="Counting"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_39CB7F84_FBC5_4861_BD11_FAC97574B2A2"
                name="Count"
                description="Total number of a collection of objects."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_D6D476D1_7FDC_4375_B79B_785E5E9EBA3D"
                name="Resolution"
                description="Describes the sharpness, fineness, or granularity of separation of the individual elements of a thing which can be produced or recorded. Examples are the separation of pixels in an image, or the separation of a chemical mixture into its component parts."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_7116FAF1_D771_4dcf_A9CF_112EC57E77D8"
              name="Density"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_4D9CB92E_1010_4fd8_9520_0184188C4374"
                name="Density"
                description="Mass of a substance per unit volume."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_29F6EF02_F3F2_4590_8A84_3F28FE25B16F"
                name="Humidity"
                description="Amount of water vapor in the atmosphere or in a gas."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_ACB62864_ED0D_4e1e_AE3D_58581E71754C"
              name="DoseEquivalent"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_29F32E46_EDB2_472d_80CA_7B91F8275889"
                name="DoseEquivalent"
                description="Biological effectiveness of an absorbed dose of ionizing radiation."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_AAFBD590_8038_4a34_B35C_1AB8A5559744"
              name="Electricity"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_FFF9F507_6448_48bd_B548_5B85F4057903"
                name="ElectricCapacitance"
                description="Ability of an item to store an electrical change."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_0B869DF6_099A_4526_95F5_4BFC7393718E"
                name="ElectricCharge"
                description="Extent to which an item has more or fewer electrons than protons."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_CAE607F9_8F99_4a23_854E_8B8536720799"
                name="ElectricChargeDensity"
                description="Electric charge per unit volume of space, in one, two or three dimensions which are per unit length, surface area, or volume respectively."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_35DDCEBF_B184_4159_B5C4_932587A840B5"
                name="ElectricCurrent"
                description="Movement of electric charge through a medium."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_60A46947_91C7_4bc7_A74D_1DE2137E5CC5"
                name="ElectricCurrentDensity"
                description="Amount of net charge that crosses an area perpendicular to the current flow per time period."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_FD27C3E6_3A30_45b8_B836_91CD599BD168"
                name="ElectricPotential"
                description="Difference in electric charge between two points."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="SDM_DDEDA360_71B5_46BB_A631_4A610C017042"
                name="ElectricResistance"
                description="Extent to which an item reduces electrical current passing through it."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="SDM_5EE014D8_2AD2_4718_92B6_57740152645E"
                name="ElectricField"
                description="The physical field that surrounds each electric charge and exerts force on all other charges in the field, either attracting or repelling them."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_29322D03_5221_4476_BCE0_FCD59CEADE7E"
              name="Energy"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_AFCB75C7_863B_4112_8F1E_2FB4FE1D4D2A"
                name="AbsorbedDose"
                description="Radiation energy absorbed by unit mass of substances."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_EEED99B8_359B_41bf_B6B0_2BA8EC5E1B07"
                name="AbsorbedDoseRate"
                description="Rate of radiation energy absorbed by unit mass of substances."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_32D02294_1A54_48ee_AA9D_2EA0EDBC4B76"
                name="Energy"
                description="Capacity of a physical system to perform work."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_53BCC2C7_42F6_46b7_9DD0_7F901BF5AF83"
              name="State"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_CAAC3A37_65D4_4c73_8361_7586C2CAC41C"
                name="ConfigurationState"
                description="Captures the particular configuration condition relevant to an entity."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_7BF4374F_EC27_40ba_B155_54CEA52345C2"
                name="HealthState"
                description="Condition of an item with respect to some purpose or use."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_FCB07A59_EABE_47c1_A408_48FB5942DEA1"
                name="Mode"
                description="A way or manner in which something occurs or is experienced, expressed, or done."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_ED7C3BF6_9851_4b9b_BCCC_5D8F81C127B7"
                name="OperationalState"
                description="The relative standing of any process, method or series of acts of a practical or mechanical nature."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_629FBDD0_AEAD_41f0_9C6F_603D7CF9D269"
                name="ValidityState"
                description="Indication of fitness of information with respect to some use or purpose."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_5D8EBA55_61ED_4e7e_8F29_9F619CA59DC0"
              name="Force"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_B4FA8AFA_1FC5_4cc3_8E95_1956D00176DC"
                name="Force"
                description="Influence on an object with a mass."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_69A1D868_1DE4_4fce_9C0B_7A47AB1FC46B"
                name="Torque"
                description="Twisting force that tends to cause rotation."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_9CF8817E_BFC5_4933_BEDB_629449526974"
              name="Identifier"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_B14C698C_13F8_434c_9D67_54CF514CA74E"
                name="Identifier"
                description="Distinguishes an item from other items.  The uniqueness of this identifier should be quantified in the realized measurement.  Identifiers may best be used in the context of an association to capture how one associated entity refers to another."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_C73A97BA_5AAF_4a5a_A17D_D3F6C6378F53"
              name="Power"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_0FE1D4CF_7DB9_46c2_961B_2C3AB44B694F"
                name="Power"
                description="Rate at which work is performed or energy is converted."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_2AA28623_C4E2_4471_85F6_79A1D13E5768"
              name="Pressure"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_54D14004_BB23_4f72_95FB_9FF384A743A7"
                name="Pressure"
                description="Force per unit area perpendicular to the surface of an item."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="SDM_4DB77607_F044_43F6_B294_1330A858AF02"
              name="RadiantIntensity"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="SDM_FF6759E2_8460_414E_97C7_7AE465C71AC4"
                name="RadiantIntensity"
                description="Power emitted by a radiation source in a particular direction per unit solid angle."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_82448C3A_F8D7_4ffd_A311_F530C41FA5ED"
              name="Rate"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_A082A853_2D96_4222_8065_D06483A48AE8"
                name="Acceleration"
                description="Rate of change of velocity per unit time."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_E0FD8349_12D2_40aa_9131_1FF4BA823E26"
                name="AngularAcceleration"
                description="Rate of change of angular velocity."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_21309243_2D0E_4536_8135_69F86BE3D515"
                name="AngularVelocity"
                description="Norm of a vector of angular motion of the target body."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_29913A1B_DFBB_4db4_AE2B_93C6CC1EF116"
                name="CountRate"
                description="Rate at which a total amount is accumulated over a time period."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_5C94882D_D81D_44fd_9A96_04915D63D7BD"
                name="DataRate"
                description="Quantity of data transferred over a defined time period."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_2435A700_DF6F_4e88_98FA_05AD14BA5F5D"
                name="MassFlowRate"
                description="Mass of substance which passes through a given surface per unit time."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_6A475A9C_9D31_4f7e_92EF_2D00DE6F7E66"
                name="OrientationAcceleration"
                description="Rate of change in Orientation Velocity."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_8A6BA64A_0232_41e4_AA18_CD71B80A66DC"
                name="OrientationVelocity"
                description="Rate of change in Orientation."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_CD425350_A680_49d4_974D_4052C9BABB30"
                name="ScalarAcceleration"
                description="Rate of change of speed."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_06B460A8_5CEC_4e63_9607_4413DB527E37"
                name="Speed"
                description="Rate at which an object covers a distance."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_6576E8D2_2D88_4881_819E_7CA0B661B8A5"
                name="TemporalFrequency"
                description="Number of occurrences of a repeating event per unit time. Events are assumed to have a uniform period."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_331BB7F2_6E37_433e_8027_991D9E82BA67"
                name="Velocity"
                description="Rate at which an object covers a distance in a specified direction."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_B1562401_E94E_4770_9F18_591A19738099"
                name="AngularJerk"
                description="Rate of change of angular acceleration."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_3D665770_0E04_42D2_A7EC_C49F9EEBB511"
                name="Jerk"
                description="Rate of change of acceleration per unit time."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_D491CAEC_EF5B_4819_B175_93DFF9F79890"
                name="OrientationJerk"
                description="Rate of change in Orientation Acceleration."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_0A5B803F_9CED_429A_8376_C02F009F6FF4"
                name="ScalarJerk"
                description="The magnitude of the rate of change of acceleration."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_C48D59AA_06DF_480b_A3DE_113C0620BD16"
              name="Temperature"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_2912B4B3_E784_4796_A911_6CE50C6872FB"
                name="Temperature"
                description="Average kinetic energy of particles in an item (i.e., how hot or cold the item is)."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_413788BB_764C_45d6_BBB3_904F396F92A3"
                name="TemperatureDelta"
                description="A change or difference between two temperatures."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_2F81B2B6_4024_4e4d_BDC2_34DBD1B84CE4"
              name="Time"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_6F2C6003_64FF_42a1_B4D1_00E34745B793"
                name="CalendarTime"
                description="Position in time, a realization of which could be a specific date and time on a calendar. This is not to be used for time durations, which would be the difference between two time observables."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_4E729952_4D4F_46f9_B372_04489372E9D4"
                name="Duration"
                description="Quantity of time, such as would be obtained from the difference between two specific date/times on a calendar (i.e., the difference between two CalendarTime observables)."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_4C132758_4862_40cf_8CC9_3F02FF5C88BD"
              name="Viscosity"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_C58154E2_40C4_466f_AAF2_CF0751E434A6"
                name="DynamicViscosity"
                description="Property of a fluid that expresses its resistance to shearing flows. Also called Shear Viscosity."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_9894902C_4D24_43b6_9EA0_3FC535B15003"
                name="KinematicViscosity"
                description="Property of a fluid that is the ratio of its resistance to shearing flows (i.e., its dynamic viscosity) to its density."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_619822DB_095A_4c7c_8B95_078BF3ACB963"
              name="Volume"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_363355FA_D46C_4c74_BF38_B9466951F1A0"
                name="ScalarVolume"
                description="Magnitude of a three dimensional space."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <element
              xmi:id="EAID_953E7031_D240_4b4c_B2E2_A5F7F6B8B28D"
              name="Metric"
              description="A function that defines a relationship between each pair of elements of a set."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="EAID_CA624FFC_15D7_4d5a_9AF8_3515E166CC5E"
              name="Order"
              description="Order is an observable that describes a measure of the position of an element in a group of elements."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="EAID_C40D7048_65D6_4c77_B067_B01C8D3EC5A2"
              name="Polarization"
              description="The action of restricting the vibrations of a transverse wave, especially light, wholly or partially to one direction."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="EAID_87855F1B_1FCE_4229_889D_1C402450C739"
              name="Size"
              description="Size is an observable that describes the magnitude or number of a measurable or countable entity."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="EAID_A8C6A8D3_CE3E_4460_A258_926948CAD4B2"
              name="Uncertainty"
              description="Not completely confident or sure. Used to describe the degree of uncertainty in a value."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="SDM_87BC163C_EAAA_41BA_BE15_BC1583ED0953"
              name="Color"
              description="The human perception of frequencies of light, characterized by the spectral density of the light."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="SDM_42F16876_807C_4B6B_9B7C_DCC75E73CF03"
              name="Gain"
              description="A multiplicative increase (or decrease, for values less than one) in the amount or rate of something.  This observable should only be used as an attribute of an Association."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="SDM_65FA5692_DBE9_40F5_87DC_DBD21BC57144"
              name="Sensitivity"
              description="The ratio of the output change to an input change.  This observable should only be used as an attribute of an Association."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="SDM_72EB2843_C4C7_41C8_A915_41CE41C2BD2A"
              name="Probability"
              description="The extent to which something is likely to occur.  More precisely, it is the relative frequency of an outcome in the hypothetical limit of an infinite number of identical experiments."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="SDM_912F5A47_36F3_4C53_924C_687194ECB6A1"
              name="Efficiency"
              description="The ratio of useful output of a machine or process compared to its input.  This observable should only be used as an attribute of an Association."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="SDM_52A8DA5A_7756_4DDB_8519_AAC142935D21"
              name="IndexOfRefraction"
              description="The ratio of the speed of light in vacuum to that in the medium."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="SDM_3E541792_9B2B_4A64_869B_3D7AA912B36C"
              name="Bias"
              description="An additive increase (or decrease, for values less than zero) in the amount or rate of something."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="SDM_1C02D10C_E79D_4DCF_A65F_3247E132D380"
              name="GraphicsState"
              description="Captures the particular graphics condition, state, or event relevant to an entity as described in graphics standard (e.g. ARINC 661 or similar standards)."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="EAID_8AE4B471_6AD8_473b_A6B8_5FA79179F21A"
              name="NonPhysicalAddress"
              description="A scheme applied over a non-physical location/space used to delineate different elements or parts (e.g., IPv4, IPv6, telephone number)."
              xmi:type="conceptual:Observable"/>
          <element
              xmi:id="SDM_15F420AB_3924_4E3F_9155_A475C3AC0245"
              name="Intent"
              description="The underlying attitude (e.g., personal, geopolitical, etc.) expressing the way in which an action is approached or executed."
              xmi:type="conceptual:Observable"/>
        </cdm>
        <cdm
            xmi:id="SDM_0A792AAE_04F2_48DB_B8EB_82B4911363BC"
            name="BasisEntities"
            xmi:type="datamodel:ConceptualDataModel">
          <element
              xmi:id="SDM_0DAA61A6_6BC4_4955_949F_F9508730F510"
              name="Encryption"
              description="A type of procedure, method, or mechanism of encryption."
              xmi:type="conceptual:BasisEntity"/>
          <element
              xmi:id="SDM_BB37D79D_95B6_4589_95B6_4B242E30E418"
              name="Path"
              description="A set of ordered adjacent points in a topological metric space"
              xmi:type="conceptual:BasisEntity"/>
          <element
              xmi:id="SDM_EACF289B_F437_47DA_804E_AE468F85BA07"
              name="Point"
              description="A position with zero dimension in a space"
              xmi:type="conceptual:BasisEntity"/>
          <element
              xmi:id="SDM_7523381A_1310_4F1E_87DE_AD849788FED2"
              name="Object"
              description="An entity or item that possesses physical substance and is capable of being detected or observed through the use of one&apos;s senses."
              xmi:type="conceptual:BasisEntity"/>
          <element
              xmi:id="SDM_08DD3350_C6EA_4CD2_A8BF_F81AC4E2CEA6"
              name="Event"
              description="A remarkable or noteworthy occurrence, incident, or happening that holds particular importance or attention due to its distinctive nature or impact."
              xmi:type="conceptual:BasisEntity"/>
          <element
              xmi:id="SDM_7EFC2BB0_B58D_46CA_9552_E1640B126212"
              name="Place"
              description="A specific location, point, or area in physical space, usually characterized by its distinct attributes, geographical coordinates, or relative position in relation to other places."
              xmi:type="conceptual:BasisEntity"/>
          <element
              xmi:id="SDM_A04AC592_8E9D_40B2_B863_E83B18F6B33B"
              name="Mission"
              description="An allocation of a resource(s) to a set of desired objectives."
              xmi:type="conceptual:BasisEntity"/>
          <element
              xmi:id="SDM_7B8920F4_6434_46B3_B961_1AC81501965B"
              name="Minimum"
              description="The smallest possible amount, value, or degree that is allowed, required, or achievable in a given context."
              xmi:type="conceptual:BasisEntity"/>
          <element
              xmi:id="SDM_2272AF9D_1B79_4167_874F_169049779671"
              name="Maximum"
              description="The greatest possible amount, value, or degree that is allowed, required, or achievable in a given context."
              xmi:type="conceptual:BasisEntity"/>
        </cdm>
        <cdm
            xmi:id="SDM_A0319D61_8C45_493A_9DD9_D4E4B74C0435"
            name="Domains"
            xmi:type="datamodel:ConceptualDataModel">
          <element
              xmi:id="SDM_C59045D5_59BA_4CDD_AC98_B88275FAB744"
              name="Sensing"
              description="The sensing domain comprises all of the data definitions relevant to the systems and participants involved in the process of sensing and classifying all things in the physical environment (e.g., physical objects, emitters, terrain, etc.)."
              xmi:type="conceptual:Domain"
              basisEntity="SDM_7523381A_1310_4F1E_87DE_AD849788FED2"/>
          <element
              xmi:id="SDM_25FA3512_773E_4C5F_AF05_BA6A65BAAC29"
              name="Warfighting"
              description="The warfighting domain encompasses all data definitions relevant to the process of warfighting. It is sometimes subdivided into separate kinds of warfighting sub-domains (e.g., Air, Surface, Subsurface, Space, Land, and Cyberspace). Each sub-domain comprises an area of responsibility with a unique operational environment requiring specialized tactics, equipment, and structure. Each may demand a different way of thinking within the broader context of military strategy. The warfighting domain encompasses all of these operational sub-domains as well as the specific technical domains relevant to systems and participants within the process of warfighting (e.g., sensing domain, C2 domain, etc.)."
              xmi:type="conceptual:Domain"
              basisEntity="SDM_08DD3350_C6EA_4CD2_A8BF_F81AC4E2CEA6 SDM_A04AC592_8E9D_40B2_B863_E83B18F6B33B SDM_7EFC2BB0_B58D_46CA_9552_E1640B126212"/>
        </cdm>
      </cdm>
    </cdm>
  </dm>
