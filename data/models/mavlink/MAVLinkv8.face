          <element
              xmi:id="EAID_BE2795B1_06AD_4261_B7E8_8A4F4D94FC84"
              name="KilogramsPerSquareMeter"
              description="Unit of measure for representing surface density in mass per unit area."
              xmi:type="logical:Unit"/>
