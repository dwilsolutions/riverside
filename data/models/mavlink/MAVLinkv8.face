        <ldm
            xmi:id="EAID_B08FDE57_5C49_41e7_9D11_EF49F447F2BC"
            name="BodyAngleLandmark_Deprecated"
            description="[DEPRECATED] All elements in this package have been deprecated.  The structure will be maintained for consistency."
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_7E2AA6B0_4E32_428e_B420_674937EB807B"
              name="BodyAngleAttitudeEquilibrium"
              description="[DEPRECATED] The point at which the local vehicle body frame has no rotation in any of the three axes that originate at the vehicle center of gravity (longitudinal, lateral, and vertical).  Please use BodyAttitudeOriginLandmark (EAID_39753BD3_1FF4_47ca_A367_845117E99553) instead."
              xmi:type="logical:Landmark"/>
          <element
              xmi:id="EAID_EB421BF8_9BA2_4b2c_9F12_89947506FFAC"
              name="BodyAnglePiOver2RadianLeftRoll"
              description="[DEPRECATED] The orientation of the local vehicle body frame with respect to the vertical axis (or lateral axis) after a -Pi/2 radian rotation along the longitudinal axis (a roll to left).  Please use BodyAttitudePiOver2RadianRollLeft (EAID_913ABE8D_D741_4b8e_AA57_E015677CB52D) instead."
              xmi:type="logical:Landmark"/>
          <element
              xmi:id="EAID_46C2DBA8_097E_4920_BA96_7CC8F27215AC"
              name="BodyAnglePiOver4RadianPitchUp"
              description="[DEPRECATED] The orientation of the local vehicle body frame with respect to the longitudinal (or vertical axis) after a Pi/4 radian rotation along the lateral axis (a pitch up).  Please use BodyAttitudePiOver4RadianPitchUp (EAID_3E7D915F_92BA_4d27_BC1A_52D9915CAFEF) instead."
              xmi:type="logical:Landmark"/>
          <element
              xmi:id="EAID_7BA5AA9E_8487_4169_8591_E8A62103DE76"
              name="BodyAnglePiOver6RadianYawLeft"
              description="[DEPRECATED] The orientation of the local vehicle body frame with respect to the longitudinal axis (or lateral axis) after a -Pi/6 radian rotation along the vertical axis (a yaw left).  Please use BodyAttitudePiOver6RadianYawLeft (EAID_F8CBB773_7EC3_4cf3_A6BF_322F5E0611A2) instead."
              xmi:type="logical:Landmark"/>
        </ldm>
        <element
            xmi:id="EAID_B892AB87_32A2_4d24_AB2E_B903C6515760"
            name="Time_Posix_Meas"
            description="[DEPRECATED] Measurement describing a instant in time as the number of seconds that have elapsed since the Unix Epoch Time (00:00:00 Coordinated Universal Time (UTC), Thursday, 1 January 1970), not counting leap seconds. For POSIX time as CalendarTime referenced to the Epoch of JAN 1, 1970 midnight (UTC), please use Time_PosixAbsolute_Meas (SDM_1817059F_9042_491D_9FDC_2F5240E14910). For POSIX time as Duration, please use Time_PosixDuration_Meas (SDM_C2DEBE25_DA57_462A_A3AC_46EFAC9695FD)."
            realizes="EAID_4E729952_4D4F_46f9_B372_04489372E9D4"
            xmi:type="logical:Measurement"
            measurementAxis="EAID_101C0D13_D395_47fb_8885_743191537CB9"
            measurementSystem="EAID_3E078B08_3024_4dfe_B01E_74929C579251"/>
        <element
            xmi:id="EAID_6B02E545_2AFD_4542_B70D_0733A337E54E"
            name="UniqueID_UUID_Text_Meas"
            description="[DEPRECATED] A measurement for uniqueIdentifiers that use UTF8 strings and are governed by the UUID (RFC 4122) standard.   Please use UUID_Meas (SDM_9AC852B6_7DDC_4040_9625_B6A0C77D5751) instead.  This measurement may be used, but may not properly represent the UUID in 128-bit form as specified in the standard."
            realizes="EAID_B14C698C_13F8_434c_9D67_54CF514CA74E"
            xmi:type="logical:Measurement"
            measurementAxis="EAID_20D9A85A_639A_49ca_8B03_1FF9070B294A"
            measurementSystem="EAID_3328F5AF_7CAE_4149_A03E_EB78F6653396"/>
        <element
            xmi:type="logical:MeasurementAxis"
            measurementSystemAxis="EAID_789E08B1_DC02_497e_A8C9_75BC1AB027CD"
            xmi:id="EAID_101C0D13_D395_47fb_8885_743191537CB9"
            name="Time_Posix_MeasAxis"
            realizes="EAID_4E729952_4D4F_46f9_B372_04489372E9D4"
            description="[DEPRECATED] Measurement axis for POSIX/Unix time duration in integer seconds"/>
        <element
            xmi:type="logical:MeasurementAxis"
            measurementSystemAxis="EAID_53E5C75D_0FAB_4090_9AB4_763E7AEF327C"
            xmi:id="EAID_20D9A85A_639A_49ca_8B03_1FF9070B294A"
            name="UniqueID_UUID_Text_MeasAxis"
            realizes="EAID_B14C698C_13F8_434c_9D67_54CF514CA74E"
            description="[DEPRECATED]  An instance of the TextUTF8MeasurementSystemAxis with a UUID constraint.  This MA exists to apply a weak constraint to the UniqueID_UUID_Text_Meas.  The new version of the measurement (SDM_9AC852B6_7DDC_4040_9625_B6A0C77D5751) obviates the need for this MA.">
          <constraint
              xmi:id="EAID_13BCA207_52F6_4552_B26B_8AA10B9CF116"
              xmi:type="logical:MeasurementConstraint"
              constraintText="UUID_RFC 4122"/>
        </element>
        <element
            xmi:type="logical:MeasurementSystem"
            measurementSystemAxis="EAID_789E08B1_DC02_497e_A8C9_75BC1AB027CD"
            coordinateSystem="EAID_D73E1979_E607_48ce_A01F_2EAD5226614D"
            xmi:id="EAID_3E078B08_3024_4dfe_B01E_74929C579251"
            name="Time_Posix_MeasSys"
            description="[DEPRECATED] Measurement system for time in accordance with the Posix. For POSIX time as CalendarTime referenced to the Epoch of JAN 1, 1970 midnight (UTC), please use Time_PosixAbsolute_MeasSys (SDM_D512DBA3_3DE2_48C4_B6BD_903CBDD37E2E). For POSIX time as Duration, please use Time_PosixDuration_MeasSys (SDM_BF24D125_FCC5_4D1F_A344_34CB1BAE5DD0)."
            orientation="Value increases as time moves towards the future"
            externalStandardReference="IEEE Std 1003.1-2008">
          <referencePoint
              xmi:id="EAID_284CB1EC_7ABC_4b2a_9318_7BC671B9CE47"
              name="PosixEpochTimeStart"
              description="POSIX/Unix time origin"
