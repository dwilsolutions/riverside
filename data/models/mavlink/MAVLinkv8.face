              specification="SELECT&#10;    sensor_join.elementID_MagicNumber AS MagicNumber,&#10;    sensor_join.elementID_PayloadLength AS PayloadLength,&#10;    sensor_join.elementID_Name_Octet AS IncompatibilityFlags_and_CompatibilityFlags_and_Packet_Sequence_Number_and_Target_System_and_Target_Component_and_Confirmation,&#10;    sensor_join.elementID_SystemIDs AS Sender_System_ID_and_Sender_Component_ID,&#10;    sensor_join.elementID_CommandLongMSB AS Message_ID_MSB,&#10;    sensor_join.elementID_LSB AS Message_ID_LSB,&#10;    antennaInstallation_join.orientation_Unbound_Pitch_Degrees_Float AS Pitch,&#10;    antennaInstallation_join.orientation_Unbound_Roll_Degrees_Float AS Roll,&#10;    antennaInstallation_join.orientation_Unbound_Yaw_Degrees_Float AS Yaw,&#10;    antennaInstallation_join.position_Unbound_Altitude_Float AS Altitude,&#10;    antennaInstallation_join.position_Unbound_Latitude_Float AS Latitude,&#10;    antennaInstallation_join.position_Unbound_Longitude_Float AS Longitude,&#10;    antennaInstallation_attrAddOn_join.mode_Unbound AS Mode,&#10;    sensor_join.elementID_Mount_Control AS Command,&#10;    sensor_join.elementID_UShort_new AS Checksum&#10;FROM Platform platform_from&#10;    JOIN HostPlatform hostPlatform_join &#10;        ON hostPlatform_join.platform = platform_from&#10;    JOIN Sensor sensor_join &#10;        ON hostPlatform_join.sensor&#10;    JOIN SensorTask sensorTask_join &#10;        ON sensorTask_join.sensor = sensor_join&#10;    JOIN Task task_join &#10;        ON sensorTask_join.task&#10;    JOIN REXActionTask rEXActionTask_join &#10;        ON rEXActionTask_join.task = task_join&#10;    JOIN REXAction rEXAction_join &#10;        ON rEXActionTask_join.rexAction&#10;    JOIN BeamControl beamControl_join &#10;        ON beamControl_join.rexAction = rEXAction_join&#10;    JOIN BeamSetPlan beamSetPlan_join &#10;        ON beamControl_join.beamSetPlan&#10;    JOIN BeamSet beamSet_join &#10;        ON beamSetPlan_join.beamSet&#10;    JOIN BeamSetAntennaInstallation beamSetAntennaInstallation_join &#10;        ON beamSetAntennaInstallation_join.beamSet = beamSet_join&#10;    JOIN AntennaInstallation antennaInstallation_join &#10;        ON beamSetAntennaInstallation_join.antennaInstallation&#10;    JOIN AntennaInstallation_attrAddOn antennaInstallation_attrAddOn_join &#10;        ON antennaInstallation_attrAddOn_join.addon = antennaInstallation_join"/>
