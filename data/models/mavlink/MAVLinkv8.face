    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_9025EB89_390A_F2BB_6A67_E4D340921B6D"
        name="EncryptorDecryptor_6_2"
        description="The Encryptor/Decryptor Module provides cryptographic services to other SOSA Modules such as encryption, decryption, pseudo-random sequence generation, and local module key management and storage. In addition, it communicates with the Security Services Module for key interchange and to report status (successful/failed result)."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_89F8BE28_7A6E39D_622BE2E_EB1A880"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_C3CC142D_3F178D4_0781B2A_80C46B5"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_673AEF1F_C28C_ADEB_FCC9_41C4A2520D5C"
        name="GuardCrossDomainService_6_3"
        description="The Guard/Cross-Domain Service Module transfers data between separate security enclaves of the same or differing security levels and prevents data leakage between enclaves."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_D9BBC961_117A696_802B12D_09E0277"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_DC782801_60C0F11_8B88C79_468100E"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_D4645865_D3E7_8A9B_B78B_57001804D64F"
        name="ImpactAssessorAndResponder_4_4"
        description="The Impact Assessor &amp; Responder Module interprets the current situation to draw inferences about enemy threats, friendly and enemy vulnerabilities, and it may project those into the future. Impact assessment may involve estimating possible outcomes and assessing an enemy’s intent based on knowledge about enemy doctrine, level of training, political environment, and the current situation. This module may develop alternate hypotheses about an enemy’s strategies, given the effect of uncertain knowledge about enemy units, tactics, and the environment. This module may also initiate a response to a threat; for example, by notification to an internal capability (e.g., electronic attack) or an external system to act (e.g., countermeasures or evasive maneuvering)."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_DFF136B5_F5BF76D_18055FC_75B0BB9"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_3A4EAC0D_A7849C7_11B3366_835B769"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_99B66D85_2C02_8CA7_8B26_9EF972B77178"
        name="NetworkSubsystem_6_4"
        description="The Network Subsystem Module is enumerates network elements, monitors the health of network elements, detects, and isolates degraded network elements, transfers data with the requested Quality of Service (QoS), and detects intrusion. Data users may request data from data sources that have requirements for update rate, latency, and priority, and the Network Subsystem module ensures that these requests are met and may report when they are not met. The Network Subsystem module may be configured to alert on thresholds such as network bandwidth exceeded. The Networking Subsystem module provides the services to request network status such as throughput, up/down status, and configuration at any time, and collects metrics to support this reporting. Intrusion detection may be configured by a network manager to alert on security breaches and to isolate the breached network channel."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_2D0F7251_314241F_B3AB45B_42470F9"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_351DCD58_16BB32F_8E6704C_8DE9A97"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_23A1BA73_9A92_91DC_4C2B_D5B57D58740C"
        name="CalibrationService_6_5"
        description="The Calibration Service Module ingests and injects the test signal and disables SOSA Modules not under test."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_E91E9AC8_09C441A_156FAF9_46A5C1C"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_20C4C9F5_1427E0C_D3BF146_E1CCB21"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_75AC51AD_B475_EDE6_978D_9E01DC2BDB11"
        name="Power_6_10"
        description="The Power Module converts, conditions, stores, distributes, and manages power. The Power Module may receive host platform power (via the Host Platform Interface module) and may convert it to the conditioned power needed by SOSA Elements. It may also include the routing and distribution of power to SOSA Elements that use it. The Power Module may provide status such as to indicate whether power is within specification and an alert to impending power loss. It also may provide a management interface that allows configuration, control, and status.&#10;Note that some SOSA Elements may be designed with integrated power supplies. That type of Element should have its own power management interface which could be aligned with the power management interface of the Power Module."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_06796447_BB49294_0A09A95_46141A1"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_4FAF8E31_D88234C_4CC4039_3033428"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_03912764_3B4C_9FBE_5A34_8AFFBC58D067"
        name="CompressorDecompressor_6_8"
        description="The Compressor/Decompressor Module reduces the volume of data for storage or transport and restores the compressed data to its original format. These functions are performed by executing codec functions."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_F048FFC7_5106F3A_D79B3B3_BB6063B"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_934A1283_2068A1A_EB1BBB7_C952132"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_D347982A_C208_BDC7_3B94_6E7A09DA82EF"
        name="ExternalDataIngestor_4_1"
        description="The External Data Ingestor Module ingests data from other sensors, converting to SOSA format as needed and distributes ingested data to other SOSA Modules. This module provides an alternate ingest path from sources outside of the Host Platform Interface."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_2496E99D_8C62E74_9948B00_3071B39"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_28249530_9264994_1829C1E_7F93921"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_E2443A17_9317_58D7_D1D7_5AAFA72214D2"
        name="TaskManager_1_2"
        description="The Task Manager Module is responsible for coordinating all mission operations. External sensor tasking is accepted in the form of a request that contains information detailing when and where to collect data, the type of processing to be performed, and the required output products to be generated. Information in the request is used by the Task Manager to optimize, manage, and prioritize resources to support various competing tasks in a SOSA sensor. Any externally invoked changes to tasking are handled by the Task Manager, which in turn propagates the mission changes into relevant mode and state changes for the other SOSA Modules. Lastly, the Task Manager is responsible for invoking routine calibration as needed to support the mission tasking."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="CPP">
      <thread
          xmi:id="SMLD_5A625EEC_1567BCA_FFF1B6B_058EF02"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_1D14140A_0B0C6C6_B9647C6_4402E04"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_5BE2AFFF_E267_AB49_6A30_687960CCFE57"
        name="EncodedDataExtractor_4_2"
        description="The Encoded Data Extractor Module is responsible for demodulating and extracting message content, extracting internals, and human language processing."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
