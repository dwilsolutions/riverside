            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_1F30EE79_9169_465b_865B_96D6C06844B4"
              name="OneAmpLandmark"
              description="A current of 1 amp means that there is 1 coulomb of charge passing through a cross section of a wire every 1 second."
              xmi:type="logical:Landmark"/>
          <element
              xmi:id="EAID_D906AAE7_5FE3_46a0_8164_81A17CE49BDB"
              name="OneAmpPerSquareMeterCurrentDensityXDirectionLandmark"
