      xmi:type="datamodel:DataModel">
    <ldm
        xmi:id="EAID_9BA39F14_4927_484a_B00F_7D1C8B0CC103"
        name="FACE_Shared_Data_Model_Logical"
        xmi:type="datamodel:LogicalDataModel">
      <ldm
          xmi:id="EAID_1D413311_4852_40a3_8919_33A7AD77146E"
          name="CoordinateSystems"
          xmi:type="datamodel:LogicalDataModel">
        <ldm
            xmi:id="EAID_C6D9C82F_78FB_4266_9615_7A637566A37F"
            name="Scalar"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="EAID_28244BCE_7916_4b0e_AD94_BACAF6B3567F"
              name="Scalar_CoordSysAxis"
              description="A scale for one dimensional scalar measurements"
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="SDM_E5C57F2E_3E4A_2227_B59F_273394E675F4"
              name="Rotation_General_CoordSysAxis"
              description="A general scalar axis for measuring rotation."
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="EAID_6DABCD14_6669_485d_A1E7_B192E1AF0275"
              name="Scalar_CoordSys"
              description="A scale for one dimensional scalar measurements"
              axisRelationshipDescription="n/a"
              angleEquation="n/a"
              distanceEquation="|v2-v1|"
              xmi:type="logical:CoordinateSystem"
              axis="EAID_28244BCE_7916_4b0e_AD94_BACAF6B3567F"/>
          <element
              xmi:id="SDM_7FF601F2_0A98_3B76_2620_2E5BBCE23C66"
              name="Rotation_General_CoordSys"
              description="One axis rotational Coordinate System.  This is a rotation about an arbitrary axis whereas the similarly formed Rotation_1D_CoordSys is about psi, or the z-axis."
              axisRelationshipDescription="n/a"
              angleEquation="n/a"
              distanceEquation="n/a"
              xmi:type="logical:CoordinateSystem"
              axis="SDM_E5C57F2E_3E4A_2227_B59F_273394E675F4"/>
        </ldm>
        <ldm
            xmi:id="EAID_1EA992A2_64A8_405a_9F50_9C328D38069D"
            name="Angular"
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="_vZiY1Ag5EeSFspy8Kj3F4Q"
              name="Angular_Inclination_CoordSysAxis"
              description="The inclination (or polar) Axis is the set of angles between the zenith direction and the line segment OP."
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="_vZiY1gg5EeSFspy8Kj3F4Q"
              name="Angular_Azimuth_CoordSysAxis"
              description="The azimuth (or azimuthal) Axis is the set of signed angles measured from the azimuth reference direction to the orthogonal projection of any line segment OP on the reference plane."
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="_vZiY1Qg5EeSFspy8Kj3F4Q"
              name="Angular_Radial_CoordSysAxis"
              description="The radius or radial Axis is the set of Euclidian Distance vectors from the origin O to any point P"
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="EAID_C3727901_373B_4ae7_B288_168F4AADA042"
              name="Polar_CoordSys"
              description="Polar Coordinate System"
              axisRelationshipDescription="S2 Right Handed Orthogonal"
              angleEquation="Alpha = Theta2 - Theta1"
              distanceEquation="d = sqrt[(r1^2 +r2^2)-(2*r1*r2*cos(Theta2-Theta1))]"
              xmi:type="logical:CoordinateSystem"
              axis="_vZiY1Qg5EeSFspy8Kj3F4Q _vZiY1gg5EeSFspy8Kj3F4Q"/>
          <element
              xmi:id="EAID_B6CBB90E_3A43_44ca_B1B9_78FED0DA3C7D"
              name="Spherical_Phi_CoordSys"
              description="The independent Phi axis of the 3 dimensional (3D) Spherically symmetric coordinate system."
              axisRelationshipDescription="S3 Right Handed Orthogonal (R, Azimuth, Inclination),"
              angleEquation="Alpha = sqrt[(Theta1^2 + Theta2^2) -2(Theta1*Theta2) * cos(Phi1-Phi2)]"
              distanceEquation="Multiple distance metrics are possible depending upon the topology"
              xmi:type="logical:CoordinateSystem"
              axis="_vZiY1Ag5EeSFspy8Kj3F4Q"/>
          <element
              xmi:id="EAID_55E0A12F_4A1A_421e_ABA8_FC11DB1A3095"
              name="Spherical_R_CoordSys"
              description="The independent R axis of the 3 dimensional (3D) Spherically symmetric coordinate system."
              axisRelationshipDescription="S3 Right Handed Orthogonal (R, Azimuth, Inclination),"
              angleEquation="Alpha = sqrt[(Theta1^2 + Theta2^2) -2(Theta1*Theta2) * cos(Phi1-Phi2)]"
              distanceEquation="Multiple distance metrics are possible depending upon the topology"
              xmi:type="logical:CoordinateSystem"
              axis="_vZiY1Qg5EeSFspy8Kj3F4Q"/>
          <element
              xmi:id="EAID_2EF70F5A_7A56_468e_AC75_6663CE3CB2F4"
              name="Spherical_Theta_CoordSys"
              description="The independent Theta axis of the 3 dimensional (3D) Spherically symmetric coordinate system."
              axisRelationshipDescription="S3 Right Handed Orthogonal (R, Azimuth, Inclination),"
              angleEquation="Alpha = sqrt[(Theta1^2 + Theta2^2) -2(Theta1*Theta2) * cos(Phi1-Phi2)]"
              distanceEquation="Multiple distance metrics are possible depending upon the topology"
              xmi:type="logical:CoordinateSystem"
              axis="_vZiY1gg5EeSFspy8Kj3F4Q"/>
          <element
              xmi:id="EAID_B6E3492E_47BE_44a5_B53B_BC44765EBCCD"
              name="Spherical_Surface_CoordSys"
              description="A spherically symmetric coordinate system for a surface"
              axisRelationshipDescription="S3 Right Handed Orthogonal (R, Azimuth, Inclination),"
              angleEquation="Alpha = sqrt[(Theta1^2 + Theta2^2) -2(Theta1*Theta2) * cos(Phi1-Phi2)]"
              distanceEquation="Multiple distance metrics are possible depending upon the topology"
              xmi:type="logical:CoordinateSystem"
              axis="_vZiY1Ag5EeSFspy8Kj3F4Q _vZiY1gg5EeSFspy8Kj3F4Q"/>
          <element
              xmi:id="_vZiY1wg5EeSFspy8Kj3F4Q"
              name="Spherical_CoordSys"
              description="A 3 dimensional (3D) Spherically symmetric coordinate system."
              axisRelationshipDescription="S3 Right Handed Orthogonal (R, Azimuth, Inclination),"
              angleEquation="Alpha = sqrt[(Theta1^2 + Theta2^2) -2(Theta1*Theta2) * cos(Phi1-Phi2)]"
              distanceEquation="Multiple distance metrics are possible depending upon the topology"
              xmi:type="logical:CoordinateSystem"
              axis="_vZiY1Ag5EeSFspy8Kj3F4Q _vZiY1Qg5EeSFspy8Kj3F4Q _vZiY1gg5EeSFspy8Kj3F4Q"/>
        </ldm>
