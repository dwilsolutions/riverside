        <element
            xmi:id="SDM_19A55A3C_3D1A_4BCD_B752_76969702B21B"
            name="DecibelWatt_deprecated"
            description="[DEPRECATED] The decibel watt or dBW is a unit for the measurement of the strength of a signal expressed in decibels relative to one watt.  Please use DecibelWatt (EAID_015ADC31_6C51_4014_9308_9AE65DCCF3B0) instead."
            xmi:type="logical:Unit"/>
        <element
            xmi:id="EAID_90D9E4E8_7A91_4dd4_A96E_DF01C3157644"
