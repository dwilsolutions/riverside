            <element
                xmi:id="EAID_6FE784C0_3B93_4de4_B23A_0A5E83DCDFBA"
                name="Nepers"
                description="Unit of measure for representing the ratio of two current, voltages, or analogous quantities. Not an SI unit."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_393B5A6F_990A_4186_92E8_F6BA2012123D"
                name="NewtonsPerMeter"
                description="Unit of measure for representing surface tension in force per unit length. SI Derived unit"
