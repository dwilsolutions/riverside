      <cdm
          xmi:id="SML_5BEC8850_EDDC_8E6A_CB17_62C0BF4DBB70"
          name="Signals"
          description="This package models signals, which are electromagnetic waves that are emitted or reflected by a single source that could be intercepted and detected by a sensor.  This package models the signal’s properties, including properties that can be detected and characterized by a sensor."
          xmi:type="datamodel:ConceptualDataModel">
        <cdm
            xmi:id="SML_176617F5_30C3_873E_A921_229D6897B153"
            name="ElectromagneticWave"
            description="This package models electromagnetic waves, their transmission by, or reflection from, a physical object, and their conversion to/from a digital representation."
            xmi:type="datamodel:ConceptualDataModel">
          <element
              xmi:id="SML_1F09C418_378F_B151_9ECF_824E3781C23E"
              name="ElectromagneticWave"
              description="An ElectromagneticWave is an electromagnetic wave in the physics sense, regardless of transport medium (whether free space, waveguide, wire, etc.) and regardless of physical manifestation or encoding (analog or digital, real or complex).  It can be at any frequency, from zero to RF to optical and beyond, and can span positive and/or negative frequencies. And as in the physics definition, an ElectromagneticWave is also a superposition of many other ElectromagneticWaves.  These superimposed waves could be components of waves from the same source, and/or multiple waves from multiple independent sources."
              xmi:type="conceptual:Entity">
            <composition
                xmi:id="SML_627E664E_BD5B_CC69_3934_E10DFB2B1D65"
                rolename="elementID"
                description=""
                upperBound="1"
                lowerBound="1"
                type="EAID_B14C698C_13F8_434c_9D67_54CF514CA74E"
                xmi:type="conceptual:Composition"/>
            <composition
                xmi:id="SML_56A34092_E618_6A8C_D08C_29194431B711"
                rolename="power"
                description="The root-mean-squared power in the electromagnetic wave, as it would be determined over some referenced time interval. The referenced time interval is defined by context or by convention, such as 1/B where B is the bandwidth."
                upperBound="1"
                lowerBound="1"
                type="EAID_0FE1D4CF_7DB9_46c2_961B_2C3AB44B694F"
                xmi:type="conceptual:Composition"/>
            <composition
