        <ldm
            xmi:id="SDM_2B911E07_D736_C2CE_9CF9_369B59A85954"
            name="Quaternion4D"
            description="Four dimensional coordinate system for defining quaternions."
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="SDM_E481DEF8_C51E_5B6A_BC0D_AD60188DEBDD"
              name="Quaternion_A_CSA"
              description="This axis represents the scalar (real) component of the quaternion.  It is often associated with magnitude or the cosine of half the rotation angle in 3D rotations."
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="SDM_6D2075C6_71F6_1E8B_1499_20649AD6FE3A"
              name="Quaternion_B_CSA"
              description="This axis represents the coefficients of the imaginary unit i.  Together, the imaginary axes (b, c, and d) these form a 3D subspace and define the orientation or rotation axis in 3D space."
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="SDM_5A492F84_FE48_25A0_A67D_6E7D53A8472F"
              name="Quaternion_C_CSA"
              description="This axis represents the coefficients of the imaginary unit j.  Together, the imaginary axes (b, c, and d) these form a 3D subspace and define the orientation or rotation axis in 3D space."
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="SDM_84C47DB9_D5B5_CA32_C5B4_DA25FE04EB3E"
              name="Quaternion_D_CSA"
              description="This axis represents the coefficients of the imaginary unit k.  Together, the imaginary axes (b, c, and d) these form a 3D subspace and define the orientation or rotation axis in 3D space."
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="SDM_5761FD6E_237E_CF68_1045_793D8D0E1CED"
              name="Quaternion_CS"
              description="A quaternion coordinate system is a 4-dimensional space defined by one real axis and three imaginary axes."
              axisRelationshipDescription="Axis &apos;a&apos; is the scalar axis.  Axes &apos;b&apos;, &apos;c&apos;, and &apos;d&apos; are orthoginal in quaternion space and establish the rotation of &apos;a&apos;."
              angleEquation="angle = acos( (q1 dot q2) / (abs(q1) * (abs(q2))"
              distanceEquation="d = sqrt((a2 - a1)^2 + (b2 - b1)^2 + (c2 - c1)^2 + (d2 - d1)^2)"
              xmi:type="logical:CoordinateSystem"
              axis="SDM_5A492F84_FE48_25A0_A67D_6E7D53A8472F SDM_6D2075C6_71F6_1E8B_1499_20649AD6FE3A SDM_84C47DB9_D5B5_CA32_C5B4_DA25FE04EB3E SDM_E481DEF8_C51E_5B6A_BC0D_AD60188DEBDD"/>
        </ldm>
        <ldm
            xmi:id="SDM_5BF8B8B1_FCD4_43DE_9D90_1DE222A94D89"
            name="Elliptical"
            description=""
            xmi:type="datamodel:LogicalDataModel">
          <element
              xmi:id="SDM_E1A2D612_8B0F_4643_9010_F9916A24BBEE"
              name="Elliptic_SemiMajorAxis_CoordSysAxis"
              description="The length of the semi-major axis of an ellipse."
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="SDM_1E973F01_42DA_4EFA_B4E3_CBE4D520CBB2"
              name="Elliptic_SemiMinorAxis_CoordSysAxis"
              description="The length of the semi-minor axis of an ellipse."
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="SDM_CA00E1E8_677D_484A_8883_D1055FC5F5D1"
              name="Elliptic_Ellipticity_CoordSysAxis"
              description="The ratio between the length of the semi-minor axis of an ellipse to the length of its semi-major axis expressed as an angle."
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="SDM_B626CBA2_49B2_406D_91ED_EC41FDAC14FD"
              name="Elliptic_Rotation_Psi_CoordSysAxis"
              description="An arbitrary rotation psi of the major axis of an ellipse about its origin and orthogonal to the major and minor axis."
              xmi:type="logical:CoordinateSystemAxis"/>
          <element
              xmi:id="SDM_A7450EFF_4A88_470F_9314_9A66CA514B54"
              name="Rotational_Elliptic_CoordSys"
              description="A rotational elliptic coordinate system."
              axisRelationshipDescription="Axes are orthogonal to each other."
              xmi:type="logical:CoordinateSystem"
              axis="SDM_1E973F01_42DA_4EFA_B4E3_CBE4D520CBB2 SDM_B626CBA2_49B2_406D_91ED_EC41FDAC14FD SDM_CA00E1E8_677D_484A_8883_D1055FC5F5D1 SDM_E1A2D612_8B0F_4643_9010_F9916A24BBEE"/>
        </ldm>
      </ldm>
      <ldm
          xmi:id="EAID_6E6385F7_641B_446e_BC94_0298C7D73125"
          name="LogicalValueTypes"
          description="The types available to represent the values of Measures"
          xmi:type="datamodel:LogicalDataModel">
        <element
            xmi:id="EAID_16DE4A98_8206_47b3_A77D_39227129E528"
            name="Boolean"
            description="A type that can represent only two values, often meaning True or False"
            xmi:type="logical:Boolean"/>
        <element
            xmi:id="EAID_372D8BFC_47B1_4385_AD77_6703541E7FAC"
            name="Integer"
            description="A whole number in the range -infinity to +infinity"
            xmi:type="logical:Integer"/>
        <element
            xmi:id="EAID_7DE12CF5_1B85_482b_9830_783D356833E9"
            name="Natural"
            description="A whole number ranging from +1 to +infinity; also called &quot;counting numbers&quot;"
            xmi:type="logical:Natural"/>
        <element
            xmi:id="EAID_1EA04603_631A_403e_82FD_D6E5825D1F31"
            name="NonNegativeReal"
            description="A real number ranging from 0 to +infinity"
            xmi:type="logical:NonNegativeReal"/>
        <element
            xmi:id="EAID_7CB1E0A3_7D27_45fa_BF9E_22EB15886D68"
            name="Real"
            description="A type to represent any numeric quantity along a continuous line. Real numbers include all rational and irrational numbers"
            xmi:type="logical:Real"/>
        <element
            xmi:id="EAID_B93CB919_D464_4577_82EB_0298B395EDB4"
            name="String"
            description="A type used to represent an ordered set of characters in some written language"
            xmi:type="logical:String"/>
        <element
            xmi:id="EAID_CE8514D2_720F_447f_AA6A_B22659E23666"
            name="Character"
            description="A type representing a single character in some written language"
            xmi:type="logical:Character"/>
      </ldm>
