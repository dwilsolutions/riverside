            <element
                xmi:id="EAID_311835BB_B20D_434d_8CBD_F5E857464151"
                name="CubicMetersPerKilogram"
                description="Unit of measure for representing specific volume of a substance as the ratio of the substance&apos;s volume per mass, the reciprocal of density."
