              xmi:id="EAID_3B4BB6FB_6B1F_4b41_8EAA_24C1CA377436"
              name="WattsPerSquareMeter"
              description="Unit of measure for representing the rate one watt of heat energy to flow through one square meter of area normal to the direction of heat flux. Derived SI Unit."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="EAID_16B1EB25_69FB_469a_B7CD_6D74B1A9AA42"
              name="KilogramsPerMeterPerMeterPerMeter"
              description="Unit of measure represented as mass per unit volume. The SI unit of kilogram per cubic meter (kg/m^3) and the cgs unit of gram per cubic centimeter (g/cm^3) are probably the most commonly used units for density. 1,000 kg/m^3 equals 1 g/cm^3."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_6B2E1FBD_C274_4333_87A4_425497AA66D2"
              name="GramsPerCentimeterPerCentimeterPerCentimeter"
              description="Unit of measure for density equal to one gram per centimeter cubed.  "
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_CC32C057_DB58_48F6_B52C_3B9B0B98E2EA"
              name="GramsPerLiter"
              description="Unit of measure for density equal to one gram per liter."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_F8643E4B_494A_407A_A35F_21FF9E90A323"
              name="GramsPerMilliliter"
              description="Unit of measure for density equal to one gram per milliliter."
              xmi:type="logical:Unit"/>
          <element
              xmi:id="SDM_2AB8E31A_440F_479C_B8D9_4FDE64A62D97"
              name="KilogramsPerLiter"
              description="Unit of measure for density equal to one kilogram per liter."
              xmi:type="logical:Unit"/>
        </ldm>
        <ldm
            xmi:id="EAID_2666FD95_0B38_4c4a_8681_F3A9B32C257E"
