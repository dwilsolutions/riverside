            xmi:type="logical:Unit"/>
        <element
            xmi:id="EAID_1268C4EA_1948_4472_B251_CDD0342B9BC1"
            name="Percent_deprecated"
            description="[DEPRECATED] A number or rate that is expressed as a certain number of parts of something divided into 100 parts.  Please use (EAID_68A9F947_C54C_4c06_84C6_29E302284981) instead."
            xmi:type="logical:Unit"/>
        <element
            xmi:id="SDM_C0C083BC_8B9E_4A59_B0FD_B16B72870BB2"
            name="MetricHorsepower_deprecated"
            description="[DEPRECATED] One metric horsepower as the power to raise a mass of 75 kilograms against the Earth&apos;s gravitational force over a distance of one metre in one second: 75 kg · 9.80665 m/s2 · 1 m / 1 s = 75 kgf·m/s = 1 PS. This is equivalent to 735.49875 W.  Please use MetricHorsePower (EAID_259AD740_FA8C_420a_AD46_6F4FFF25F502) instead."
            xmi:type="logical:Unit"/>
        <element
            xmi:id="EAID_7C107E2B_CDC3_4f2f_86AD_DBEC40A0C0E3"
            name="RealRadiansPerSecondValuetypeUnit"
            description="[DEPRECATED] Value type unit for real radians per second.  Please use RealRadiansPerSecond (EAID_222F7273_01B5_4e83_B616_DFEC1E04ABED) instead."
            unit="EAID_C21F5F62_131A_4807_894F_A58BF924B164"
            valueType="EAID_7CB1E0A3_7D27_45fa_BF9E_22EB15886D68"
            xmi:type="logical:ValueTypeUnit"/>
        <element
            xmi:id="EAID_D2F368C7_B356_4229_B15D_89F2E1A76DC7"
            name="RealRadiansPerSecondSquared"
            description="[DEPRECATED] Orientation acceleration in radians per second squared as a real numerical representation.  Please use RealRadiansPerSecondPerSecond (EAID_8AB5E4C7_4D23_411d_B40D_01DD8CDD2525) instead."
            unit="EAID_F2444AAF_68C5_4355_8AB0_5BFC0A73975F"
            valueType="EAID_7CB1E0A3_7D27_45fa_BF9E_22EB15886D68"
            xmi:type="logical:ValueTypeUnit"/>
        <element
