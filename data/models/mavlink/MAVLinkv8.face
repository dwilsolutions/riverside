              xmi:id="SMLD_EA89AE71_C96FAC2_35957EA_51CE0BB"
              name="Query_MAV_CMD_DO_MOUNT_CONFIGURE"
              xmi:type="platform:Query"
              specification="SELECT&#10;    sensor_join.elementID_MagicNumber AS MagicNumber,&#10;    sensor_join.elementID_PayloadLength AS PayloadLength,&#10;    sensor_join.elementID_Name_Octet AS IncompatabilityFlags_and_CompatabilityFlags_and_Packet_Sequence_Number_and_Target_System_and_Target_Component_and_Confirmation,&#10;    sensor_join.elementID_SystemIDs AS Sender_System_ID_and_Sender_Component_ID,&#10;    sensor_join.elementID_CommandLongMSB AS Message_ID_MSB,&#10;    sensor_join.elementID_LSB AS Message_ID_LSB,&#10;    pLACEHOLDER_join.mode AS Mode,&#10;    pLACEHOLDER_join.operationalState AS Stabilize_Roll_and_Stabilize_Pitch_and_Stabilize_Yaw,&#10;    pLACEHOLDER_join.orientation_Roll_Input_mode AS Roll_Input_Mode,&#10;    pLACEHOLDER_join.orientation_Pitch_Input_Mode AS Pitch_Input_Mode,&#10;    pLACEHOLDER_join.orientation_Yaw_input_mode AS Yaw_Input_Mode,&#10;    sensor_join.elementID_Mount_Config AS Command,&#10;    sensor_join.elementID_UShort_new AS Checksum&#10;FROM Platform platform_from&#10;    JOIN HostPlatform hostPlatform_join &#10;        ON hostPlatform_join.platform = platform_from&#10;    JOIN Sensor sensor_join &#10;        ON hostPlatform_join.sensor&#10;    JOIN PLACEHOLDER_Assoc pLACEHOLDER_Assoc_join &#10;        ON pLACEHOLDER_Assoc_join.sensor = sensor_join&#10;    JOIN PLACEHOLDER pLACEHOLDER_join &#10;        ON pLACEHOLDER_Assoc_join.PLACEHOLDER"/>
          <element
              xmi:id="SMLD_A7D90D6B_C3A89FF_532AA28_B055684"
              name="Query_MAV_CMD_DO_MOTOR_TEST"
              xmi:type="platform:Query"
              specification="SELECT&#10;    sensor_join.elementID_MagicNumber AS MagicNumber,&#10;    sensor_join.elementID_PayloadLength AS PayloadLength,&#10;    sensor_join.elementID_Name_Octet AS IncompatibilityFlags_and_CompatibilityFlags_and_Packet_Sequence_Numbers_and_Target_Component_and_Target_System_and_Confirmation,&#10;    sensor_join.elementID_SystemIDs AS Sender_System_ID_and_Sender_Component_ID,&#10;    sensor_join.elementID_CommandLongMSB AS Message_ID_MSB,&#10;    sensor_join.elementID_LSB AS Message_ID_LSB,&#10;    motor_join.elementID AS Instance,&#10;    motor_join.power_MotorTestThrottleType_Float AS ThrottleType,&#10;    motor_join.power_PowerPercentFloat AS Throttle,&#10;    motor_test_join.duration AS Timeout,&#10;    motor_test_join.count AS MotorCount,&#10;    motor_test_join.order AS TestOrder,&#10;    sensor_join.elementID_Motor_Test AS Command,&#10;    sensor_join.elementID_UShort_new AS Checksum&#10;FROM Platform platform_from&#10;    JOIN HostPlatform hostPlatform_join &#10;        ON hostPlatform_join.platform = platform_from&#10;    JOIN Sensor sensor_join &#10;        ON hostPlatform_join.sensor&#10;    JOIN Platform_Test platform_Test_join &#10;        ON platform_Test_join.platform = platform_from&#10;    JOIN Test test_join &#10;        ON platform_Test_join.test&#10;    JOIN motor_test motor_test_join &#10;        ON motor_test_join.test = test_join&#10;    JOIN motor motor_join &#10;        ON motor_test_join.motor"/>
          <element
              xmi:id="SMLD_640FBBE4_28559FC_773F0CB_50335A6"
              name="Query_MAV_CMD_INJECT_FAILURE"
              xmi:type="platform:Query"
              specification="SELECT&#10;    sensor_join.elementID_MagicNumber AS MagicNumber,&#10;    sensor_join.elementID_PayloadLength AS PayloadLength,&#10;    sensor_join.elementID_Name_Octet AS IncompatibilityFlags_and_CompatibilityFlags_and_Packet_Sequence_Number_and_Target_System_and_Target_Component_and_Confirmation,&#10;    sensor_join.elementID_SystemIDs AS Sender_System_ID_and_Sender_Component_ID,&#10;    sensor_join.elementID_CommandLongMSB AS Message_ID_MSB,&#10;    sensor_join.elementID_LSB AS Message_ID_LSB,&#10;    pLACEHOLDER_join.identifier_FAILURE_UNIT AS Failure_unit,&#10;    pLACEHOLDER_join.kind AS Failure_type,&#10;    pLACEHOLDER_join.identifier_UniqueID_Integer_Float AS Instance,&#10;    sensor_join.elementID_InjectFailure_Val AS Command,&#10;    sensor_join.elementID_UShort_new AS Checksum&#10;FROM Platform platform_from&#10;    JOIN HostPlatform hostPlatform_join &#10;        ON hostPlatform_join.platform = platform_from&#10;    JOIN Sensor sensor_join &#10;        ON hostPlatform_join.sensor&#10;    JOIN PLACEHOLDER_Assoc pLACEHOLDER_Assoc_join &#10;        ON pLACEHOLDER_Assoc_join.sensor = sensor_join&#10;    JOIN PLACEHOLDER pLACEHOLDER_join &#10;        ON pLACEHOLDER_Assoc_join.PLACEHOLDER"/>
          <element
              xmi:id="SMLD_9E193773_8176921_A4DC6B0_66A3ECE"
              name="Query_MAV_CMD_COMPONENT_ARM_DISARM"
              xmi:type="platform:Query"
              specification="SELECT&#10;    sensor_join.elementID_MagicNumber AS MagicNumber,&#10;    sensor_join.elementID_PayloadLength AS PayloadLength,&#10;    sensor_join.elementID_Name_Octet AS IncompatibilityFlags_and_CompatibilityFlags_and_Packet_Sequence_Number_and_Target_System_and_Target_Component_and_Confirmation,&#10;    sensor_join.elementID_SystemIDs AS Sender_System_ID_and_Sender_Component_ID,&#10;    sensor_join.elementID_CommandLongMSB AS Message_ID_MSB,&#10;    sensor_join.elementID_LSB AS Message_ID_LSB,&#10;    armTask_join.operationalState_Unbound AS Arm,&#10;    armTask_join.configurationState_Unbound AS Force,&#10;    sensor_join.elementID_Arm AS Command,&#10;    sensor_join.elementID_UShort_new AS Checksum&#10;FROM Platform platform_from&#10;    JOIN HostPlatform hostPlatform_join &#10;        ON hostPlatform_join.platform = platform_from&#10;    JOIN Sensor sensor_join &#10;        ON hostPlatform_join.sensor&#10;    JOIN PlatformTask platformTask_join &#10;        ON platformTask_join.platform = platform_from&#10;    JOIN Task task_join &#10;        ON platformTask_join.task&#10;    JOIN ArmTask armTask_join &#10;        ON armTask_join.task = task_join"/>
          <element
              xmi:id="SMLD_7F163BA0_B576CF3_E460E88_87C8AC2"
              name="Query_MAV_CMD_DO_SET_CAM_TRIGG_INTERVAL"
              xmi:type="platform:Query"
              specification="SELECT&#10;    sensor_join.elementID_MagicNumber AS MagicNumber,&#10;    sensor_join.elementID_PayloadLength AS PayloadLength,&#10;    sensor_join.elementID_Name_Octet AS IncompatibilityFlags_and_CompatibilityFlags_and_Packet_Sequence_Number_and_Target_System_and_Target_Component_and_Confirmation,&#10;    sensor_join.elementID_SystemIDs AS Sender_System_ID_and_Sender_Component_ID,&#10;    sensor_join.elementID_CommandLongMSB AS Message_ID_MSB,&#10;    sensor_join.elementID_LSB AS Message_ID_LSB,&#10;    pLACEHOLDER_join.duration AS Trigger_Cycle_and_Shutter_Integration,&#10;    pLACEHOLDER_join.identifier_targetCameraID AS Target_Camera_ID,&#10;    sensor_join.elementID_Cam_int AS Command,&#10;    sensor_join.elementID_UShort_new AS Checksum&#10;FROM Platform platform_from&#10;    JOIN HostPlatform hostPlatform_join &#10;        ON hostPlatform_join.platform = platform_from&#10;    JOIN Sensor sensor_join &#10;        ON hostPlatform_join.sensor&#10;    JOIN PLACEHOLDER_Assoc pLACEHOLDER_Assoc_join &#10;        ON pLACEHOLDER_Assoc_join.sensor = sensor_join&#10;    JOIN PLACEHOLDER pLACEHOLDER_join &#10;        ON pLACEHOLDER_Assoc_join.PLACEHOLDER"/>
        </pdm>
      </pdm>
    </pdm>
  </dm>
  <dm
      xmi:id="SDM_9D9C0080_9EF6_4E29_9309_FC4079C9E16B"
      name="SDM_3_1_15"
