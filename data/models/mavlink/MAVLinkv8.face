              name="Cartesian_3D_CoordSys"
              description="Three dimensional Cartesian coordinate system."
              axisRelationshipDescription="Axes are orthogonal to each other."
              angleEquation="theta = inverse cos ((a dot b)/(|a|*|b|)), where a and b are vectors."
              distanceEquation="d = sqrt((x2-x1)^2 + (y2-y1)^2 + (z2-z1)^2)"
              xmi:type="logical:CoordinateSystem"
              axis="EAID_185CD9A8_B677_41ab_907D_C7F232756DCE EAID_3EFC05DA_4D3A_4e3d_8AEC_C9FEC8D85087 EAID_C74601C9_0E7A_483b_AD4C_28D64BE141E3"/>
          <element
