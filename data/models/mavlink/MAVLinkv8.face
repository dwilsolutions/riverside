            <composition
                xmi:id="SML_F2D64FB8_EDDE_549A_A37A_E514F5A85B70"
                rolename="fullScaleVoltage"
                description="This is the number of volts the digitization function measures between its minimum and maximum digital values.  For example, for an N-bit linear digitizer,  the least significant bit is equivalent to fullScaleVoltage / (2^N) volts"
                upperBound="1"
                lowerBound="1"
                type="EAID_FD27C3E6_3A30_45b8_B836_91CD599BD168"
                xmi:type="conceptual:Composition"/>
            <composition
                xmi:id="SML_D15FE6AA_A6AD_6A17_E4CE_8F651CA17A17"
                rolename="resolution"
                description="This is the number of bits of quantization in the digitization function.  (This is an integer.)"
                upperBound="1"
                lowerBound="1"
                type="EAID_D6D476D1_7FDC_4375_B79B_785E5E9EBA3D"
                xmi:type="conceptual:Composition"/>
            <composition
                xmi:id="SML_A45C5BDD_A373_4171_1B47_09508BFA8344"
                rolename="effectiveResolution"
                description="This is the number of bits of quantization in the digitization function that are noise free. This is a property of the digitization function, and is calculated or measured and can have a non-integer value.  effectiveResolution  is always &lt;= resolution.  (This is a floating point number.)"
                upperBound="1"
                lowerBound="1"
                type="EAID_D6D476D1_7FDC_4375_B79B_785E5E9EBA3D"
                xmi:type="conceptual:Composition"/>
            <participant
                xmi:id="SML_051E359C_2B06_57D7_5607_6AE8DD412E8D"
                rolename="wave"
                upperBound="1"
                lowerBound="1"
                sourceUpperBound="-1"
                sourceLowerBound="0"
                type="SML_1F09C418_378F_B151_9ECF_824E3781C23E"
                xmi:type="conceptual:Participant"/>
            <composition
                xmi:id="SML_D6E2145C_6DAC_5748_6440_955A5854BD9E"
                rolename="fullScalePower"
                description="This is the root-mean-squared (RMS) power of a sinusoidal voltage, the size of fullScaleVoltage peak-to-peak, measured across the impedance (resistance) used by the digitization function to digitize the input voltage.  If a digitizer measures the input voltage across a resistance R, then fullScalePower =  Vrms ^2 / R, where Vrms is the RMS input voltage, which is  (fullScaleVoltage /2) / sqrt(2)."
                upperBound="1"
                lowerBound="1"
                type="EAID_0FE1D4CF_7DB9_46c2_961B_2C3AB44B694F"
                xmi:type="conceptual:Composition"/>
