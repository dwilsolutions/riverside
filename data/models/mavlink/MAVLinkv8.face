            <element
                xmi:id="EAID_40659D46_18A7_4bdf_A4E2_B6DB4B5FE62B"
                name="LitersPerHour"
                description="Unit of measure for volume flow rate."
                xmi:type="logical:Unit"/>
            <element
                xmi:id="EAID_02B18938_8AD8_4ec0_A8C2_B7DFFCC1CE8E"
                name="MillimetersPerHour"
                description="Unit of measure for representing the number of millimeters traveled in one hour used in speed and velocity metrics."
