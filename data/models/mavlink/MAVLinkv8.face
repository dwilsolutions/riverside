              landmark="EAID_E3DB5E79_28F5_4546_AF37_5C5C59EAA687">
            <referencePointPart
                xmi:id="EAID_100655DF_5991_4cfa_AE21_558FBE47C299"
                valueTypeUnit="EAID_D4E6F91B_E17A_42b5_9D3F_A5A852B8519E"
                axis="EAID_789E08B1_DC02_497e_A8C9_75BC1AB027CD"
                value="0"
                xmi:type="logical:ReferencePointPart"/>
          </referencePoint>
          <referencePoint
              xmi:id="EAID_BD9DFD8C_8109_4fca_AE6D_751BDFE80A13"
              name="PositiveOneSecondAfterEpochStart"
              description="Duration of positive one second"
