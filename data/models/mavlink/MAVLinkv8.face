    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_E8762C5C_06AF_AAC3_3140_2992E6413AEA"
        name="SituationalAssessor_4_3"
        description="The Situation Assessor Module determines current relationships among objects and events in the context of their environment. The  individual signals and objects are examined to aggregate them into operationally meaningful groups. In addition, this module focuses on relational information (e.g., physical proximity, communications, causal, temporal, and other relations) to determine the meanings of groups of entities. This analysis is performed in the context of environmental information about terrain, surrounding media, hydrology, weather, and other factors."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="CPP">
      <thread
          xmi:id="SMLD_CA6C603C_1E7801B_B1F4A08_16EA855"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_3E6F2972_06EC668_0606995_5315E34"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_B0805F4F_2DB3_2D40_6E66_A67A2A715EFE"
        name="Tracker_3_4"
        description="The Tracker Module correlates detections and tracks over time, forming new or updated tracks. It is responsible for all track management functions and producing track reports. The core functionality of the Tracker is data association, track initiation, track drop, track update, state and covariance estimation, and split track handling. Additional functionality includes estimation of relative position or location (e.g., geolocation), including pose estimation, aimpoint refinement, and target state estimation."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="CPP">
      <thread
          xmi:id="SMLD_1E39E902_CC7C93C_188A8FD_E62F6AC"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_73712719_F66C534_E169151_7BD872B"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_9D8391D4_4725_E967_866F_32DE0F44EB0C"
        name="ImagePreProcessor_3_3"
        description="The Image Pre-processor Module forms the image and/or prepares it for final use by processing sensed data. This may include enhancing images like Non-Uniform Correction (NUC), dead pixel mapping, image sharpening, and contrast enhancement, reformatting into standard formats (e.g., NITF, MISB), or registering/correlating images to geographical coordinates and/or other images."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="CPP">
      <thread
          xmi:id="SMLD_ABA646BE_7B72EF7_E9A6812_5F205ED"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_D63142BE_0D9E6BE_8162E03_AB6793D"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_9BEF64B5_4FAC_1684_F98A_8C86E4F145F6"
        name="SignalObjectCharacterizer_3_2"
        description="The Signal/Object Characterizer Module makes measurements on images, signals, and physical objects to determine attributes, properties, categories, classes, types, or identification – all with confidence estimates."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="CPP">
      <thread
          xmi:id="SMLD_36FD2A24_03233E9_1FAC7E2_67B561A"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_CBDC6EE1_5B29D47_0D490F8_0CE9066"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_D66B9B72_5D23_5531_77F1_F3CA80EEC942"
        name="StorageRetrievalManager_4_6"
        description="The Storage/Retrieval Manager Module stores a variety of data types in a persistent medium and allows it to be retrieved in bulk by authorized client entities. The Storage/Retrieval Manager may be used for short-term (in-mission) data as well as long-term (or archival) purposes. Data that may be stored includes health reports, heartbeats, notifications (health, configuration, and control notifications), streaming data, and metadata."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_FF6E0AD9_169FF61_8058300_A3DF1E8"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_852A4835_0A65CFE_5A853F5_26D23AC"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_1665BC8B_81DC_F172_ECEA_47D15CBB4BA4"
        name="SignalObjectDetectorAndExtractor_3_1"
        description="The Signal/Object Detector &amp; Extractor Module detects EM signals or physical objects among the noise and other signals and objects in the environment (e.g., clutter or interference). This module extracts a detected signal, detected object, and/or image chip for downstream processing. Techniques to perform this may include clutter suppression, extraction of scintillation/de-correlation information, interference suppression, the use of constant false alarm rate techniques, coherent and non-coherent integration, Space-Time Adaptive Processing (STAP), image enhancement (including edge detection and sharpening), and employment of gating logic to manage and balance search volume returns with existing object tracks."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="CPP">
      <thread
          xmi:id="SMLD_21B64AB3_59F3E39_46563A8_5138B0A"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_763007CB_F08F00B_1604EBA_0E30A9A"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_AE75E573_7D67_A5B2_DFF0_04992CCA658F"
        name="ReportingServices_5_1"
        description="The Reporting Services Module generates and disseminates reports. Specifically, the Reporting Services module is responsible for formatting, processing (as required by sensor type), packaging data for reporting, structuring data to match a selected format, and dissemination of data to intended recipients. Such data can include RF signal, image/video streams, demodulated signal, metadata for streams, detections, characterized targets, associated and non-associated targets/threats, assessed behaviors, alerts, sensor cues/tips, complex data (data between raw and fully processed), logging or test information, and responsible reporting commands. The module accepts/rejects requests for existing data in storage, retrieving requested data, aggregating data, and selecting data to be reported. The module also selects header/packet structure for streaming data. The Reporting Services module must be capable of storing report templates germane to the sensor type; and accept updates to those templates (e.g., metadata updates to format types)."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="CPP">
      <thread
          xmi:id="SMLD_B9ECF684_3B40C3B_3BD4C20_0F84BF2"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_50B8D489_A1E8653_26EE858_878570E"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_14E32AEB_CE06_D52A_FE4C_666E3F977755"
        name="SecurityServices_6_1"
        description="The Security Services Module controls all sensor protection functionality. This includes software/data integrity checks, control access, zeroizing sensitive data, managing keys, auditing, root of security, environmental checks, and response actions. It also interacts with the Encryptor/Decryptor Module for key management local to that module."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_BFA94CDA_30EFAD5_465A98A_69B8C35"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_1F422FD5_1E78F40_34EDD3B_B45D593"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_74DFE757_DCFB_1614_FC1C_CDBA80DB2F00"
        name="ReceiverExciterCamera_2_3"
        description="The Receiver-Exciter/Camera Module performs receive tasking, transmit tasking, or both. Receive tasking may include calibration, channelization, image formation, tagging with metadata, data framing, and data cube formation. Transmit tasking may include waveform generation, calibration, and adaptation to spectrum use. For RF applications, the signal may be amplified, filtered, frequency translated, distributed, and signal domain converted – Analog to Digital Conversion (ADC) and Digital to Analog Conversion (DAC). For optical applications, the camera may include the Focal Plane Array (FPA) or detector, and may include implementations for functionality like Non-Uniform Correction (NUC) or dead pixel mapping, as well as gimbal control."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="CPP">
      <thread
          xmi:id="SMLD_3263EFE9_FB4100A_737915C_4CDB6B2"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_AF0386FA_FAB3AAF_76FABA7_1B2D35C"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_C04F8F3D_2191_959A_2BF1_F2FD44EB320C"
        name="EmitterCollector_2_4"
        description="The Emitter/Collector Module converts between Electromagnetic (EM) energy and electric signals, acting as a receiver, a transmitter, or both. This module may include mechanical and electronic steering, beam forming, focus control, and preparing analog/digital raw data products for processing. The signal may be stabilized and calibrated. The signal may be amplified, filtered, frequency translated, distributed, and signal domain converted (ADC and DAC)."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_B94DBBBD_8ADEDCA_DF70C45_5C5C426"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_1076AE42_335AB9A_A5CF504_5ADB358"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_4558CDBB_820D_15F4_EB6C_577A4CB203A3"
        name="SystemManager_1_1"
        description="The System Manager Module is responsible for implementing functions necessary to manage the overall SOSA sensor system, its hardware and software infrastructure, and the security controls applied to it. System management functions include Discovery (identifying and obtaining information required to communicate with the SOSA sensor and its sensor components), Configuration (obtaining a detailed description of the sensor, its sensor components, and the security controls applied, reading and setting configuration parameters, and updating software packages), Control (monitoring and setting control parameters for the sensor and its modules, such as mode and state, and performing control actions such as reset or BIT), and Health Management (publishing periodic health reports, notifying occurrence of configuration, control, and health events, and logging health reports and events), and Security Management (monitoring of the system to detect and counter cybersecurity anomalies and threats). The System Manager applies these functions to the SOSA sensor as a whole, to its modules, its hardware and software infrastructure, its security controls, and its interface to the sensor host. The System Manager does not manage or control the mission, tasking, or operational aspects of the SOSA sensor, but instead takes care of the SOSA sensor itself so it can implement the mission."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="CPP">
      <thread
          xmi:id="SMLD_2A7E112B_7985786_1534B65_A5AFD12"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_3B381763_8B9DB4E_F2DBDA0_D530CCC"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_9084A291_A857_7D90_6D80_6C752EB7741C"
        name="PlugInCard_7_1"
        description=""
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_79D38CB8_781B94C_FE86219_A4E07A7"
