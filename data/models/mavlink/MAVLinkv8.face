    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_587872C9_41E0_59AA_E0B6_1BB43A21D163"
        name="PNTService_6_7"
        description="The PNT Service Module provides position and navigation information, time and/or frequency information – or a combination of position and navigation – to the rest of the system. It translates platform 3D position, 3D velocity, time, and 3D platform orientation into a generic format compliant with SOSA interface standards, common across all sensor types. The service will select, smooth, blend, or exclude data as requested or necessary to create the best solution. The PNT Service may optionally provide time information as a high precision time signal that is a higher precision than that typically provided by GPS (although it could be synchronized with GPS). Discrete time output signals are optionally provided and could be used by any other module. The PNT Services Module may optionally provide Local Oscillator (LO) / frequency references, highly accurate and stable output signals suitable for GHz range RF systems to any other module without a request."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="C">
      <thread
          xmi:id="SMLD_167691CD_D9CC692_636860F_16C2C77"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_82802B76_CCE3D77_8A78D1C_AAC1B79"
          xmi:type="uop:RAMMemoryRequirements"/>
    </element>
    <element
        xmi:type="uop:PortableComponent"
        xmi:id="SML_E0B24AAD_3B06_793F_B57B_C07331E87B69"
        name="HostPlatformInterface_6_9"
        description="The Host Platform Interface (HPI) is the SOSA Module responsible for all resource exchanges with the Host Platform. These resource exchanges come in three categories: (1) Information (e.g., the exchange of data and signals), (2) Power (enabling the Host Platform to provide electrical power support to the SOSA sensor), and (3) Thermal (e.g., enabling the Host Platform to supply coolant to the SOSA system). The HPI Module is the only means by which  the SOSA system interacts with the Host Platform."
        faceProfile="GeneralPurpose"
        partitionType="POSIX"
        transportAPILanguage="CPP">
      <thread
          xmi:id="SMLD_BEF1E711_1668EAF_05AF395_83F40F0"
          xmi:type="uop:Thread"/>
      <memoryRequirements
          xmi:id="SMLD_C2000460_BBD8ACD_FAE42CD_5BF7331"
          xmi:type="uop:RAMMemoryRequirements"/>
