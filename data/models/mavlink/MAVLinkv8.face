    <cdm
        xmi:id="EAID_3511E63F_1D0B_4e10_A561_57648BBF67D4"
        name="Conceptual_Model"
        xmi:type="datamodel:ConceptualDataModel">
      <cdm
          xmi:id="SDM_790A8C2B_091D_4D9B_B708_EAEEA707CB23"
          name="FACE_Shared_Data_Model_Conceptual"
          xmi:type="datamodel:ConceptualDataModel">
        <cdm
            xmi:id="EAID_B39E9DAD_7B4E_4eff_89C0_FCD963B8235C"
            name="Observables"
            xmi:type="datamodel:ConceptualDataModel">
          <cdm
              xmi:id="SDM_D951054D_1C58_4C16_B348_34F9271A9366"
              name="AssociationObservables"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="SDM_A131A0E9_6F41_4B27_8A3A_69D3FA0D8890"
                name="Ratio"
                description="The quantitative relation between two amounts showing the number of times one value contains or is contained within the other.  This should only be used within an Association and should identify the two participating attributes using the path attribute of the associated entity."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="SDM_E013D43D_4E33_4DA0_9A75_5EF97DCD8FBC"
              name="ProductObservables"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="SDM_27B8B1EB_F1D3_43A4_9884_5C744FD0AB7D"
                name="Image"
                description="A representation of the external form of an object.  Measurements should be referenced to an external standards."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="SDM_0AFE6578_583C_4C37_8A97_037062BC3CA4"
                name="Video"
                description="The reproduction, display or broadcast of moving visual images.  Measurements should be referenced to an external standards."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="SDM_DE46D106_05B4_4A0F_A47C_60C0C9B7C8BE"
                name="Audio"
                description="The reproduction or transmission of sound data.  Measurements should be referenced to an external standards."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_FD9862C9_B48C_481a_8116_AF98D0A35708"
              name="AmountOfSubstance"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_280D1606_DD95_455c_B535_04810D45E721"
                name="AmountOfSubstance"
                description="Quantity of elementary entities, such as atoms, molecules, electrons, and other particles."
                xmi:type="conceptual:Observable"/>
            <element
                xmi:id="EAID_0016984E_BB39_4f54_95F7_41C62B101EBF"
                name="ChemicalConcentration"
                description="Amount of substance contained within a defined volume or mass."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_23E097F2_6E1A_4d74_B068_649072247CC5"
              name="Angle"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_5977632F_0313_4d51_82A4_E716D94C7D7D"
                name="Angle"
                description="Divergence of two straight lines from a common point or of two planes from a common line.  This should typically be used within an Association indicating the angle between two associated entities."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_98D3DCF6_6061_48db_9FC9_9BD741CA665C"
              name="Area"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_4B94E0C3_63C2_4166_9A21_564E6B39FEE1"
                name="ScalarArea"
                description="Magnitude of a surface space."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_BC5499CE_F7FA_4e9c_810F_9E8C3CE5ADC3"
              name="Illuminance"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_F07E3618_8CE7_4422_9D21_C8FBB9D77794"
                name="Illuminance"
                description="Total luminous flux incident on a surface per unit area."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="SDM_714CD245_E72C_4646_BA3C_B81380A2C366"
              name="Irradiance"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="SDM_7C315F29_0FED_4160_97C0_05ABE8C37021"
                name="Irradiance"
                description="Radiant flux (i.e. radiant power) incident on a surface per unit area."
                xmi:type="conceptual:Observable"/>
          </cdm>
          <cdm
              xmi:id="EAID_944C9593_EADB_41f9_BE22_B7F71BBA5E8E"
              name="InformationElement"
              description="Abstract information that applies to attributes of an entity (e.g., text, diagrams, labels, etc.)"
              xmi:type="datamodel:ConceptualDataModel">
            <cdm
                xmi:id="EAID_2C638398_A0AC_44a1_9E25_D41B7D44B547"
                name="Kind"
                xmi:type="datamodel:ConceptualDataModel">
              <element
                  xmi:id="EAID_83B70E53_9E0D_4223_8D53_C07C30BD5CB3"
                  name="Kind"
                  description="Describes the concept of a type descriptor."
                  xmi:type="conceptual:Observable"/>
            </cdm>
            <cdm
                xmi:id="EAID_1234D951_C778_464c_84EB_7081F576A92E"
                name="Description"
                xmi:type="datamodel:ConceptualDataModel">
              <element
                  xmi:id="EAID_137FD219_342E_47be_A785_7324D2954BAB"
                  name="Description"
                  description="Summary level information about an item."
                  xmi:type="conceptual:Observable"/>
            </cdm>
          </cdm>
          <cdm
              xmi:id="EAID_7C07FAB4_CDF5_4a09_9787_55E357205B81"
              name="Length"
              xmi:type="datamodel:ConceptualDataModel">
            <element
                xmi:id="EAID_80D92BE8_8DF0_4f7c_82A6_CBF5DF17443A"
                name="Distance"
                description="Amount of separation between two points."
