              xmi:id="SML_D1D78B73_AC92_9F14_214F_A57AC0E6ABCC"
              name="EMWaveModulation"
              description="Modulation is a process of converting one form of a wave (the modulating wave) into another form (the modulated wave) by algorithmically combining the modulating wave with a third wave (the carrier). Modulation is the process run in the forward direction (combining the two waves to produce the modulated wave). Demodulation is the process of running the process in the opposite direction, by removing the carrier from the modulated wave to produce the original modulating wave.  EMWaveModulation represents both modulation and demodulation as an association among these three waves."
              xmi:type="conceptual:Association">
            <composition
                xmi:id="SML_2DC6F5FB_D233_46D7_1157_C5EEF8918678"
