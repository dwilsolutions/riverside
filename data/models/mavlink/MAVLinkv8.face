            <element
                xmi:id="EAID_8A1D5A42_58C1_4f1e_BEA8_A1A3EBA33FA1"
                name="Control_Surface_3D_Rotation_Meas"
                description="The measure of geometric deflection in 3 axis of a motivator component&apos;s movement about a hinge line axis. A hinge line axis is one of the axes of the motivator coordinate system."
                realizes="EAID_5977632F_0313_4d51_82A4_E716D94C7D7D"
                xmi:type="logical:Measurement"
                measurementAxis="EAID_18E2EDD7_7BE7_4679_9867_3E03FC1926BE EAID_2D251A0D_0160_4d8b_B928_0DE7D0FCF72F EAID_F00C573D_C42C_4970_94CB_B53BBBB8A9EF"
                measurementSystem="EAID_F71A06C9_43D2_4f02_9732_5BD8A6821820"/>
            <element
                xmi:id="SDM_64A87C0D_F83B_4000_BB82_4264B67765A6"
                name="Control_Surface_2D_Rotation_Meas"
                description="The measure of geometric deflection in 2 axis (y, z) of a motivator component&apos;s movement about a hinge line axis. A hinge line axis is one of the axes of the motivator coordinate system. Used for coupled motivators such as ruddervator."
                realizes="EAID_5977632F_0313_4d51_82A4_E716D94C7D7D"
                xmi:type="logical:Measurement"
                measurementAxis="EAID_18E2EDD7_7BE7_4679_9867_3E03FC1926BE EAID_F00C573D_C42C_4970_94CB_B53BBBB8A9EF"
                measurementSystem="EAID_F71A06C9_43D2_4f02_9732_5BD8A6821820"/>
            <element
                xmi:id="SDM_D3A23B7D_8E03_413D_AC85_8B448B07CA9D"
                name="Control_Surface_Aileron_Rotation_Meas"
                description="The measure of geometric deflection about the y axis hinge line of an aileron motivator component&apos;s movement. Used for motivators that produce a torque about the x axis such as ailerons. Positive deflection produces a positive roll."
                realizes="EAID_5977632F_0313_4d51_82A4_E716D94C7D7D"
                xmi:type="logical:Measurement"
                measurementAxis="EAID_F00C573D_C42C_4970_94CB_B53BBBB8A9EF"
                measurementSystem="EAID_F71A06C9_43D2_4f02_9732_5BD8A6821820"/>
            <element
                xmi:id="SDM_8EFA1A13_2CE7_45B5_9A9C_216858F9560B"
                name="Control_Surface_X_Rotation_Meas"
                description="The measure of geometric deflection about the x axis hinge line of a motivator component&apos;s movement. A hinge line axis is one of the axes of the motivator coordinate system. Used for motivators that produce a torque about the x axis."
                realizes="EAID_5977632F_0313_4d51_82A4_E716D94C7D7D"
                xmi:type="logical:Measurement"
                measurementAxis="EAID_2D251A0D_0160_4d8b_B928_0DE7D0FCF72F"
                measurementSystem="EAID_F71A06C9_43D2_4f02_9732_5BD8A6821820"/>
            <element
                xmi:id="SDM_3671C38A_86A9_4216_A9BD_9EAEC61E6BE5"
                name="Control_Surface_Y_Rotation_Meas"
                description="The measure of geometric deflection about the y axis hinge line of a motivator component&apos;s movement. Used for motivators that produce a torque about the y axis such as elevators. Negative deflection produces a positive pitch."
                realizes="EAID_5977632F_0313_4d51_82A4_E716D94C7D7D"
                xmi:type="logical:Measurement"
                measurementAxis="EAID_F00C573D_C42C_4970_94CB_B53BBBB8A9EF"
                measurementSystem="EAID_F71A06C9_43D2_4f02_9732_5BD8A6821820"/>
            <element
                xmi:id="SDM_B13B8961_5471_4AFF_9294_37BD75070587"
                name="Control_Surface_Z_Rotation_Meas"
                description="The measure of geometric deflection about the z axis hinge line of a motivator component&apos;s movement. Used for motivators that produce a torque about the z axis such as rudders. Positive deflection produces a negative yaw."
                realizes="EAID_5977632F_0313_4d51_82A4_E716D94C7D7D"
                xmi:type="logical:Measurement"
                measurementAxis="EAID_18E2EDD7_7BE7_4679_9867_3E03FC1926BE"
                measurementSystem="EAID_F71A06C9_43D2_4f02_9732_5BD8A6821820"/>
            <element
                xmi:type="logical:MeasurementAxis"
                measurementSystemAxis="EAID_B9A4674C_EF3F_4c3b_B084_0AE83A7EDE82"
                xmi:id="EAID_2D251A0D_0160_4d8b_B928_0DE7D0FCF72F"
                name="Control_Surface_X_Rotation_MeasAxis"
                realizes="EAID_5977632F_0313_4d51_82A4_E716D94C7D7D"
                description="The axis for geometric deflection values about the x axis hinge line of a motivator component&apos;s movement. A hinge line axis is one of the axes of the motivator coordinate system. Used for motivators that produce a torque about the x axis."/>
            <element
                xmi:type="logical:MeasurementAxis"
                measurementSystemAxis="EAID_755E2E3E_7159_44b6_8C08_3DA8DE7E52A9"
                xmi:id="EAID_F00C573D_C42C_4970_94CB_B53BBBB8A9EF"
                name="Control_Surface_Y_Rotation_MeasAxis"
                realizes="EAID_5977632F_0313_4d51_82A4_E716D94C7D7D"
                description="The axis for geometric deflection values about the y axis hinge line of a motivator component&apos;s movement. Used for motivators that produce a torque about the y axis such as elevators. Negative deflection produces a positive pitch."/>
            <element
                xmi:type="logical:MeasurementAxis"
                measurementSystemAxis="EAID_C899BE01_4890_4853_A178_936DA868CBF9"
                xmi:id="EAID_18E2EDD7_7BE7_4679_9867_3E03FC1926BE"
                name="Control_Surface_Z_Rotation_MeasAxis"
                realizes="EAID_5977632F_0313_4d51_82A4_E716D94C7D7D"
                description="The axis for geometric deflection values about the z axis hinge line of a motivator component&apos;s movement. Used for motivators that produce a torque about the z axis such as rudders. Positive deflection produces a negative yaw."/>
          </ldm>
