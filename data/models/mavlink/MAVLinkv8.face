            xmi:id="EAID_D0C34A2D_4DF4_435b_BD0D_39375F4DC173"
            name="StringUnitless"
            description="The StringUnitless ValueType is typically used for text based measurement systems."
            unit="EAID_0C482F2C_A548_4cf1_B9AD_5086FD62C41B"
            valueType="EAID_B93CB919_D464_4577_82EB_0298B395EDB4"
            xmi:type="logical:ValueTypeUnit"/>
        <element
            xmi:id="EAID_C6177F0A_A31C_496d_8F54_D3C02C9FA020"
            name="UTC_SecondOfMinute"
            description="Second of the hour and minute of the Gregorian Day, Month, Year of the measurement. UTC minutes usually have 60 seconds, but the last minute of the last day of a month can have 59 or 61 seconds."
            unit="EAID_17A1BB83_047A_4b42_A183_1237BC07B435"
            valueType="EAID_372D8BFC_47B1_4385_AD77_6703541E7FAC"
            xmi:type="logical:ValueTypeUnit">
          <constraint
              xmi:id="EAID_921B1D6C_6254_44e5_8454_D836DF6B4046"
              xmi:type="logical:IntegerRangeConstraint"
              description="UTC second of day starts at 0 and ranges to the number of seconds in a minute minus 1. UTC minutes usually have 60 seconds, but the last minute of the last day of a month can have 59 or 61 seconds."
              name="UTC_SecondOfMinuteConstraint"
              upperBound="60"/>
        </element>
        <element
            xmi:id="EAID_770A3B26_286B_4669_9D59_28EEEDDFA38D"
            name="UTC_DayOfGregorianMonth"
            description="Day of the Gregorian Month and Year of the measurement"
            unit="EAID_55641AED_3F8A_497b_BF82_630E05CFCEE4"
            valueType="EAID_372D8BFC_47B1_4385_AD77_6703541E7FAC"
            xmi:type="logical:ValueTypeUnit">
          <constraint
              xmi:id="EAID_E5263524_9EF8_4bea_BF77_DB5811A1CA39"
              xmi:type="logical:IntegerRangeConstraint"
              description="UTC (and Gregorian) Day of Month is represented by values from 1 for the first day of the month to the number of days in the month, which depends on the month and year, but never exceeds 31"
              name="UTC_DayOfMonthConstraint"
              upperBound="31"
              lowerBound="1"/>
        </element>
        <element
            xmi:id="EAID_4363AD8C_A1ED_447c_8074_A9C2C1BFAD59"
            name="UTC_GregorianYear"
            description="Gregorian calendar year of the measurement"
            unit="SDM_85A59335_1C8F_47C0_8BEA_5FE1B34F6FAB"
            valueType="EAID_372D8BFC_47B1_4385_AD77_6703541E7FAC"
            xmi:type="logical:ValueTypeUnit"/>
        <element
            xmi:id="EAID_7CE0FD03_E2B8_4a2b_BEF3_AC063A10AF19"
            name="UTC_HourOfGregorianDay"
            description="Hour of the Gregorian Day, Month, Year of the measurement. Each UTC day contains exactly 24 hours."
            unit="EAID_ACBBECC7_C23C_48d8_8355_ED0A3A3A3324"
            valueType="EAID_372D8BFC_47B1_4385_AD77_6703541E7FAC"
            xmi:type="logical:ValueTypeUnit">
          <constraint
              xmi:id="EAID_C2BB6D22_F3FC_4b14_8CCB_6543C0CD22D5"
              xmi:type="logical:IntegerRangeConstraint"
              description="UTC Hour of Day starts a 0 and ends at 23. All days are 24 hours long."
              name="UTC_HourOfDayConstraint"
              upperBound="23"/>
        </element>
        <element
            xmi:id="EAID_6BBAF578_C863_44a7_A3E6_EDCF0E358B65"
            name="UTC_MinuteOfHour"
            description="Minute of the hour of the Gregorian Day, Month, Year of the measurement. Each UTC hour contains exactly 60 minutes."
            unit="EAID_D16C8EB8_AEA3_4dc4_B32D_2EA864931180"
            valueType="EAID_372D8BFC_47B1_4385_AD77_6703541E7FAC"
            xmi:type="logical:ValueTypeUnit">
          <constraint
              xmi:id="EAID_0F803579_FBA4_47ea_948A_0E98A06E0885"
              xmi:type="logical:IntegerRangeConstraint"
              description="UTC Minute of hour starts at 0 and ends at 59. There are always 60 minutes per hour, though sometimes the last minute may be 1 sec longer or shorter than the other minutes"
              name="UTC_MinuteOfHourConstraint"
              upperBound="59"/>
        </element>
        <element
            xmi:id="EAID_E2FA4AF7_5100_4797_A1BD_B5E448ED93EE"
            name="UTC_MonthOfGregorianYear"
            description="Month of the Gregorian Year of the measurement"
            unit="SDM_7E4540FB_D607_4E34_8610_3397A8A19D1E"
            valueType="EAID_372D8BFC_47B1_4385_AD77_6703541E7FAC"
            xmi:type="logical:ValueTypeUnit">
          <constraint
              xmi:id="EAID_18669915_5A53_4caa_9D0A_354EE23975D8"
              xmi:type="logical:IntegerRangeConstraint"
              description="UTC (and Gregorian calendar) uses values of 1 through 12 to represent the 12 months January through December, respectively"
              name="UTC_MonthOfYearConstraint"
              upperBound="12"
              lowerBound="1"/>
        </element>
        <element
            xmi:id="EAID_F525FE9D_FC27_4971_AB94_AAB65C8FD169"
            name="UTC_LocalTimeHourOffset"
            description="The number of hours that the local time is before or after the prime meridian (Zulu time). This offset represents the difference from Zulu due to time zone and daylight savings time."
            unit="EAID_ACBBECC7_C23C_48d8_8355_ED0A3A3A3324"
            valueType="EAID_372D8BFC_47B1_4385_AD77_6703541E7FAC"
            xmi:type="logical:ValueTypeUnit">
          <constraint
              xmi:id="EAID_EBF61D38_B48D_4398_BF79_EA01FD593B76"
              xmi:type="logical:IntegerRangeConstraint"
              description="UTC time offset can range from UTC-12:00 to UTC+14:00 in 15 minute increments. This element is just the hour component of the offset."
              name="UTC_LocalTimeHourOffsetConstraint"
              upperBound="14"
              lowerBound="-12"/>
        </element>
        <element
            xmi:id="EAID_DA807F63_757D_47ee_9A1A_4C45CFA6E054"
            name="UTC_LocalTimeMinuteOffset"
            description="The minute component of the hour:minute offset that the local time is before or after the prime meridian (Zulu time). Values can range from -45 to +45 in 15 min increments."
            unit="EAID_D16C8EB8_AEA3_4dc4_B32D_2EA864931180"
            valueType="EAID_372D8BFC_47B1_4385_AD77_6703541E7FAC"
            xmi:type="logical:ValueTypeUnit">
          <constraint
              xmi:id="EAID_C4A9341E_CD92_4f67_B09D_364B1B811CD4"
              xmi:type="logical:IntegerRangeConstraint"
              description="UTC time offset can range from UTC-12:00 to UTC+14:00 in 15 minute increments. This element is just the minute component of the offset."
              name="UTC_LocalTimeMinuteOffsetConstraint"
              upperBound="45"
              lowerBound="-45"/>
        </element>
        <element
            xmi:id="SML_3F7FECEC_5AF9_EF2C_61B9_26963747DF2E"
            name="IntegerWeeks"
            description="Weeks represented as an integer value."
            unit="SDM_A3D49224_E4EC_498F_8C79_0907AFC3F1C8"
            valueType="EAID_372D8BFC_47B1_4385_AD77_6703541E7FAC"
            xmi:type="logical:ValueTypeUnit"/>
        <element
            xmi:id="SDM_6E527670_A4CD_4A11_8DDA_C1E77D72B241"
            name="RealMillimeters"
            description="Millimeters represented as a Real"
            unit="EAID_380536E1_27EB_4939_AA22_68976D95172B"
            valueType="EAID_7CB1E0A3_7D27_45fa_BF9E_22EB15886D68"
            xmi:type="logical:ValueTypeUnit"/>
      </ldm>
