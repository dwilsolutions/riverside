          <ldm
              xmi:id="SDM_66E81732_920A_4F88_8284_210CC560101D"
              name="QuaternionMeasurement"
              xmi:type="datamodel:LogicalDataModel">
            <element
                xmi:id="SDM_429B9E73_0C3A_09E1_2439_E16C9B1B5530"
                name="Quaternion"
                description="A quaternion is a mathematical entity with four components: one real part and three imaginary parts.  It is often used to represent rotations in 3D space because it avoids issues like gimbal lock and provides smooth interpolation.  A quaternion is written as: q = a + bi + cj + dk.  &#10;&#10;Where: &#10;- a is the real part&#10;- b, d, and d are the imaginary parts"
                realizes="EAID_AB3FAE18_6F92_4a74_812F_77AF2DCD6F6F"
                xmi:type="logical:Measurement"
                measurementAxis="SDM_3E498F56_8BA1_FCF3_EBD5_DBE1FCC7C951 SDM_5B547A88_BB82_40F5_30B7_37C9AEF51B35 SDM_DDF0B6E9_2673_4465_835C_50001A37D349 SDM_E849B41B_71DA_9E0F_720E_669105BC45CE"
                measurementSystem="SDM_2CADFEA7_7EA9_1F77_8585_C5D1E5AE7DE8"/>
            <element
                xmi:type="logical:MeasurementAxis"
                measurementSystemAxis="SDM_739B1432_4246_1FA3_9BBD_9A12EA75B490"
                xmi:id="SDM_E849B41B_71DA_9E0F_720E_669105BC45CE"
                name="Quaternion_A_MA"
                realizes="EAID_AB3FAE18_6F92_4a74_812F_77AF2DCD6F6F"
                description="This axis represents the scalar (real) component of the quaternion.  It is often associated with magnitude or the cosine of half the rotation angle in 3D rotations."/>
            <element
                xmi:type="logical:MeasurementAxis"
                measurementSystemAxis="SDM_82BF9902_09CD_5C80_68A2_FD52BB15B123"
                xmi:id="SDM_DDF0B6E9_2673_4465_835C_50001A37D349"
                name="Quaternion_B_MA"
                realizes="EAID_AB3FAE18_6F92_4a74_812F_77AF2DCD6F6F"
                description="This axis represents the coefficients of the imaginary unit i.  Together, the imaginary axes (b, c, and d) these form a 3D subspace and define the orientation or rotation axis in 3D space.  The unit quaternion for this axis (0, 1, 0, 0) results in a 180 degree rotation about the x-axis."/>
            <element
                xmi:type="logical:MeasurementAxis"
                measurementSystemAxis="SDM_D9348B7D_7B43_71CA_7693_0508546654F2"
                xmi:id="SDM_3E498F56_8BA1_FCF3_EBD5_DBE1FCC7C951"
                name="Quaternion_C_MA"
                realizes="EAID_AB3FAE18_6F92_4a74_812F_77AF2DCD6F6F"
                description="This axis represents the coefficients of the imaginary unit j.  Together, the imaginary axes (b, c, and d) these form a 3D subspace and define the orientation or rotation axis in 3D space.  The unit quaternion for this axis (0, 0, 1, 0) results in a 180 degree rotation about the y-axis."/>
            <element
                xmi:type="logical:MeasurementAxis"
                measurementSystemAxis="SDM_147B9949_53CC_5E65_6A00_27D6C4921D53"
                xmi:id="SDM_5B547A88_BB82_40F5_30B7_37C9AEF51B35"
                name="Quaternion_D_MA"
                realizes="EAID_AB3FAE18_6F92_4a74_812F_77AF2DCD6F6F"
                description="This axis represents the coefficients of the imaginary unit k.  Together, the imaginary axes (b, c, and d) these form a 3D subspace and define the orientation or rotation axis in 3D space.  The unit quaternion for this axis (0, 0, 0, 1) results in a 180 degree rotation about the z-axis."/>
          </ldm>
