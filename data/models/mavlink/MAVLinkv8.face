        <cdm
            xmi:id="SML_4058EE94_F958_6491_3D73_6DFD76455D2C"
            name="Beams"
            description="A beam is formed by the superposition pattern of EM Waves emitted by an array of antennas.  This package models all aspects of antenna beams, including main beams, lobes, nulls, beam patterns, and beam steering."
            xmi:type="datamodel:ConceptualDataModel">
          <element
              xmi:id="SML_51737C59_2967_AF05_713C_56D2C3A6EA51"
              name="BeamSet"
              description="A beam set is a group of antenna beams (i.e. Lobes) that are pointed together as a group.  Each lobe in the BeamSet has a pointing direction that is relative to the BeamSet pointing direction, and usually that relative pointing direction is held fixed while the BeamSet is steered as a group.  When the BeamSet is steered, all lobes in the BeamSet are also steered together."
              xmi:type="conceptual:Entity">
            <composition
                xmi:id="SML_CBC0B77D_5327_96D2_35CD_98A86C23D36B"
                rolename="elementID"
                description=""
                upperBound="1"
                lowerBound="1"
                type="EAID_B14C698C_13F8_434c_9D67_54CF514CA74E"
                xmi:type="conceptual:Composition"/>
            <composition
                xmi:id="SML_DDC6EC1B_B155_1545_C5FA_01B4A38962F8"
                rolename="pointingType"
                upperBound="1"
                lowerBound="1"
                type="EAID_FCB07A59_EABE_47c1_A408_48FB5942DEA1"
                xmi:type="conceptual:Composition"/>
            <composition
                xmi:id="SML_A90CE0F4_0511_4813_A945_550D66CB6DFA"
                rolename="pointingVector"
                upperBound="1"
                lowerBound="1"
                type="EAID_AB3FAE18_6F92_4a74_812F_77AF2DCD6F6F"
                xmi:type="conceptual:Composition"/>
          </element>
          <element
              xmi:id="SML_B43E2BA9_BDD6_FA94_6DD2_93C6200A5856"
              name="Taper"
              description="Taper is the manipulation of the spatial amplitude distribution across a lobe. It can be viewed as a weighting function applied to a lobe, often used to flatten the lobe’s shape."
              xmi:type="conceptual:Entity">
            <composition
                xmi:id="SML_55C13B82_0BC1_4DFB_2532_82A3964E076C"
                rolename="elementID"
                upperBound="1"
                lowerBound="1"
                type="EAID_B14C698C_13F8_434c_9D67_54CF514CA74E"
                xmi:type="conceptual:Composition"/>
          </element>
          <element
              xmi:id="SML_43CA6680_7389_113A_D363_B1E58D1B0DC0"
              name="Lobe"
              description="A 3 dimensional pattern of positive energy radiation or reception within a beampattern as compared to points within the pattern which are negated (nulled) to a greater degree."
              xmi:type="conceptual:Entity">
