          <element
              xmi:id="EAID_24DF0495_0101_413a_8B3E_5132DFC4095F"
              name="JoulesPerCubicMeter"
              description="Unit of measure for representing useful energy in joules released from on cubic meter of fuel volume during complete combustion."
